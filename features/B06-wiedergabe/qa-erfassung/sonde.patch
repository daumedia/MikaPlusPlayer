+    func test06_Steuerung() async {
+        let b = Self.base
+        let av = AVKitPlaybackEngine()
+        let vlc = PlaybackEngineFactory.engine(for: URL(string: "\(b)/tslive/t06.ts")!)
+        host(av, index: 0); host(vlc, index: 1)
+        av.load(URL(string: "\(b)/livehls/t06/index.m3u8")!)
+        vlc.load(URL(string: "\(b)/tslive/t06.ts")!)
+        _ = await watch([("06-av", av), ("06-vlc", vlc)], seconds: 6)
+
+        for (label, e) in [("06-av", av), ("06-vlc", vlc)] as [(String, any PlaybackEngine)] {
+            out("\(label)|start|vol=\(e.volume)|muted=\(e.isMuted)|paused=\(e.isPaused)|\(detail(e))")
+            // ↑ an der Obergrenze
+            for _ in 0..<3 { e.setVolume(e.volume + 0.05) }
+            out("\(label)|3x hoch bei 1.0|vol=\(e.volume)|\(detail(e))")
+            // ↓ in 5-%-Schritten bis unter 0
+            var seq: [String] = []
+            for i in 1...22 {
+                e.setVolume(e.volume - 0.05)
+                seq.append("\(i):\(e.volume)|\(Int((e.volume * 100).rounded()))%")
+            }
+            out("\(label)|22x runter|\(seq.joined(separator: " "))")
+            out("\(label)|nach runter|vol=\(e.volume)|muted=\(e.isMuted)|\(detail(e))")
+            // Stumm, dann ↓ bzw. ↑
+            e.setVolume(0.5)
+            e.toggleMute()
+            out("\(label)|0.5 + stumm|vol=\(e.volume)|muted=\(e.isMuted)|\(detail(e))")
+            e.setVolume(e.volume - 0.05)
+            out("\(label)|stumm, dann runter|vol=\(e.volume)|muted=\(e.isMuted)|\(detail(e))")
+            e.toggleMute()
+            e.setVolume(0.0)
+            out("\(label)|lautstärke 0|vol=\(e.volume)|muted=\(e.isMuted)|\(detail(e))")
+            e.setVolume(0.05)
+            out("\(label)|0 -> 0.05|vol=\(e.volume)|muted=\(e.isMuted)|\(detail(e))")
+            e.setMuted(true); e.setMuted(true)
+            out("\(label)|setMuted(true) x2|muted=\(e.isMuted)|\(detail(e))")
+            e.setMuted(false)
+            e.setVolume(1.0)
+            // Play/Pause
+            e.togglePlayPause()
+            try? await Task.sleep(nanoseconds: 2_000_000_000)
+            out("\(label)|nach Pause 2s|paused=\(e.isPaused)|state=\(name(e.state))|\(detail(e))")
+            e.togglePlayPause()
+            try? await Task.sleep(nanoseconds: 2_000_000_000)
+            out("\(label)|nach Play 2s|paused=\(e.isPaused)|state=\(name(e.state))|\(detail(e))")
+        }
+        av.pause(); vlc.pause()
+    }
