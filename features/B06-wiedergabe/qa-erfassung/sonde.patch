+    private func key(_ chars: String, code: UInt16, mods: NSEvent.ModifierFlags = [], label: String? = nil) async {
+        guard let w = Self.mainWin ?? NSApp.keyWindow else { B06Probe.log("taste \(label ?? chars): kein Fenster"); return }
+        if !w.isKeyWindow {
+            B06Probe.log("fenster \(w.windowNumber) nicht Schlüsselfenster (keyWindow=\(NSApp.keyWindow?.windowNumber ?? -1), App aktiv=\(NSApp.isActive)) – aktiviere")
+            NSApp.activate(ignoringOtherApps: true)
+            w.makeKeyAndOrderFront(nil)
+            await sleep(0.4)
+        }
+        let direct = !w.isKeyWindow
+        let ign = chars
+        for type in [NSEvent.EventType.keyDown, .keyUp] {
+            if let ev = NSEvent.keyEvent(with: type, location: .zero, modifierFlags: mods, timestamp: ProcessInfo.processInfo.systemUptime,
+                                         windowNumber: w.windowNumber, context: nil, characters: chars,
+                                         charactersIgnoringModifiers: ign, isARepeat: false, keyCode: code) {
+                if type == .keyDown { B06Probe.log("sende taste \(label ?? chars) an fenster \(w.windowNumber)\(direct ? " (direkt, Fenster nicht Schlüsselfenster)" : "")") }
+                if direct { w.sendEvent(ev) } else { NSApp.sendEvent(ev) }
+            }
+        }
+        await sleep(0.05)
+    }
+
+    private func click(_ w: NSWindow, at p: CGPoint) async {
+        for type in [NSEvent.EventType.leftMouseDown, .leftMouseUp] {
+            if let ev = NSEvent.mouseEvent(with: type, location: p, modifierFlags: [], timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: w.windowNumber, context: nil, eventNumber: 0, clickCount: 1, pressure: 1) {
+                NSApp.sendEvent(ev)
+            }
+        }
+        B06Probe.log("klick an \(p) in fenster \(w.windowNumber)")
+        await sleep(0.05)
+    }
+
+    private func pressButton(titled title: String) -> Bool {
+        func walk(_ e: NSObject, _ depth: Int) -> Bool {
+            guard depth < 60 else { return false }
+            let label = (e.accessibilityAttributeValue(.title) as? String) ?? ""
+            let desc = (e.accessibilityAttributeValue(.description) as? String) ?? ""
+            let role = (e.accessibilityAttributeValue(.role) as? String) ?? ""
+            if role == "AXButton" && (label == title || desc == title) {
+                e.accessibilityPerformAction(.press)
+                return true
+            }
+            for c in (e.accessibilityAttributeValue(.children) as? [Any] ?? []).compactMap({ $0 as? NSObject }) {
+                if walk(c, depth + 1) { return true }
+            }
+            return false
+        }
+        for w in NSApp.windows where w.isVisible { if walk(w, 0) { return true } }
+        return false
+    }
+
+    private func axTexts() -> [String] {
+        var out: [String] = []
+        func walk(_ e: NSObject, _ depth: Int) {
+            guard depth < 60 else { return }
+            for a in [NSAccessibility.Attribute.title, .description, .value] {
+                if let s = e.accessibilityAttributeValue(a) as? String, !s.isEmpty { out.append(s) }
+            }
+            for c in (e.accessibilityAttributeValue(.children) as? [Any] ?? []).compactMap({ $0 as? NSObject }) { walk(c, depth + 1) }
+        }
+        if let w = NSApp.keyWindow ?? NSApp.mainWindow { walk(w, 0) }
+        return out
+    }
+    #endif
