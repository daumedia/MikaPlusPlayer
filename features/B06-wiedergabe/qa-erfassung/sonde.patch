+    @MainActor
+    private func runScript() async {
+        let script = ProcessInfo.processInfo.environment["B06_SCRIPT"] ?? ""
+        B06Probe.log("start skript=\(script)")
+        #if os(macOS)
+        B06Probe.installBeepGuard()
+        NSApp.activate(ignoringOtherApps: true)
+        await sleep(1.0)
+        if let w = NSApp.keyWindow ?? NSApp.windows.first {
+            B06Probe.log("Beep-Wächter aktiv für \(type(of: w)): \(B06Probe.beepGuardActive(for: w))")
+        }
+        Self.mainWin = NSApp.keyWindow ?? NSApp.windows.first { $0.isVisible }
+        B06Probe.log("fenster: \(windowInfo())")
+        switch script {
+        case "leak": await scriptLeak()
+        case "retry": await scriptRetry()
+        case "auth": await scriptAuth()
+        case "keys": await scriptKeys()
+        case "vlc": await scriptVLC()
+        case "errors": await scriptErrors()
+        case "windows": await scriptWindows()
+        default: B06Probe.log("unbekanntes skript")
+        }
+        B06Probe.log("ENDE engines: \(B06Probe.engineReport())")
+        try? XtreamCredentialStore.standard.deleteAll()
+        await sleep(1.0)
+        NSApp.terminate(nil)
+        #else
+        switch script {
+        case "ios-orientation": await scriptIOSOrientation()
+        default: B06Probe.log("unbekanntes skript")
+        }
+        B06Probe.log("ENDE engines: \(B06Probe.engineReport())")
+        try? XtreamCredentialStore.standard.deleteAll()
+        #endif
+    }
