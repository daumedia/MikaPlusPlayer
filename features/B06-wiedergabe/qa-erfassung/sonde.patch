+/// B06-Sonde (nur Scratchpad-Kopie): Protokoll, schwache Engine-Registratur, zeitgesteuerte Abläufe.
+enum B06Probe {
+    static var enabled: Bool { ProcessInfo.processInfo.environment["B06_SCRIPT"] != nil }
+
+    static func log(_ s: String) {
+        guard enabled else { return }
+        NSLog("B06 %@", s)
+    }
+
+    final class WeakBox { weak var engine: AnyObject?; let label: String; let created = Date()
+        init(_ e: AnyObject, _ l: String) { engine = e; label = l } }
+    @MainActor static var engines: [WeakBox] = []
+
+    @MainActor static func register(_ e: any PlaybackEngine, _ label: String) {
+        engines.append(WeakBox(e, label))
+        log("engine erzeugt #\(engines.count) \(type(of: e)) für \(label)")
+    }
+
+    @MainActor static func engineReport() -> String {
+        engines.enumerated().map { i, b in
+            guard let e = b.engine else { return "#\(i + 1) \(b.label)=freigegeben" }
+            var d = ""
+            if let p = Mirror(reflecting: e).children.first(where: { $0.label == "player" })?.value as? AVPlayer {
+                d = "rate=\(p.rate)"
+            }
+            if let v = Mirror(reflecting: e).children.first(where: { $0.label == "mediaPlayer" })?.value as? NSObject {
+                d = "vlcState=\((v.value(forKey: "state") as? NSNumber)?.intValue ?? -1) playing=\((v.value(forKey: "playing") as? NSNumber)?.boolValue ?? false)"
+            }
+            let pe = e as? any PlaybackEngine
+            return "#\(i + 1) \(b.label)=lebt state=\(pe.map { "\($0.state)" } ?? "?") paused=\(pe?.isPaused ?? false) \(d)"
+        }.joined(separator: " ; ")
+    }
+
+    #if os(macOS)
+    /// Ersetzt `noResponderFor:` (Weg des Systembeeps bei unbehandeltem keyDown) durch ein Protokoll ohne Ton.
+    @MainActor static var beepIMPs: [IMP] = []
+    @MainActor static func installBeepGuard() {
+        let sel = NSSelectorFromString("noResponderFor:")
+        for cls in [NSResponder.self, NSWindow.self, NSApplication.self, NSView.self] as [AnyClass] {
+            var count: UInt32 = 0
+            guard let list = class_copyMethodList(cls, &count) else { continue }
+            var has = false
+            for i in 0..<Int(count) where method_getName(list[i]) == sel { has = true }
+            free(list)
+            guard has, let m = class_getInstanceMethod(cls, sel) else { continue }
+            typealias Fn = @convention(c) (AnyObject, Selector, Selector) -> Void
+            let origFn = unsafeBitCast(method_getImplementation(m), to: Fn.self)
+            let block: @convention(block) (AnyObject, Selector) -> Void = { obj, eventSel in
+                if eventSel == #selector(NSResponder.keyDown(with:)) {
+                    NSLog("B06 SYSTEMBEEP-WUERDE-ERTOENEN noResponderFor:keyDown: in %@ (unterdrueckt)", String(describing: type(of: obj)))
+                } else {
+                    origFn(obj, sel, eventSel)
+                }
+            }
+            let imp = imp_implementationWithBlock(block)
+            method_setImplementation(m, imp)
+            beepIMPs.append(imp)
+            log("Beep-Wächter installiert auf \(cls)")
+        }
+    }
+    @MainActor static func beepGuardActive(for window: NSWindow) -> Bool {
+        let sel = NSSelectorFromString("noResponderFor:")
+        let imp = class_getMethodImplementation(type(of: window), sel)
+        return beepIMPs.contains { $0 == imp }
+    }
+    #endif
+
+    static let toggleFullscreen = Notification.Name("b06.toggleFullscreen")
+    static let retry = Notification.Name("b06.retry")
+    static let tap = Notification.Name("b06.tap")
+}
