+    private func scriptLeak() async {
+        let steps: [(String, String, String)] = [
+            ("A1", "HLS A1 ohne Bedienung", "http://127.0.0.1:18906/livehls/leak-a1/index.m3u8"),
+            ("B1", "HLS B1 ohne Bedienung", "http://127.0.0.1:18906/livehls/leak-b1/index.m3u8"),
+            ("A2", "HLS A2 mit Leertaste", "http://127.0.0.1:18906/livehls/leak-a2/index.m3u8"),
+            ("B2", "HLS B2 mit Vollbild", "http://127.0.0.1:18906/livehls/leak-b2/index.m3u8"),
+            ("C1", "TS C1 ohne Bedienung", "http://127.0.0.1:18906/tslive/leak-c1.ts"),
+            ("D1", "HLS D1 ohne Bedienung", "http://127.0.0.1:18906/livehls/leak-d1/index.m3u8"),
+        ]
+        for (k, name, url) in steps {
+            let c = makeChannel(k, name, url)
+            push(c)
+            await sleep(5.0)
+            if k == "A2" { await key(" ", code: 49, label: "Leertaste"); await sleep(1); await key(" ", code: 49, label: "Leertaste"); await sleep(1) }
+            if k == "B2" { await key("f", code: 3, label: "f"); await sleep(3); await key("\u{1b}", code: 53, label: "Esc"); await sleep(3) }
+            report("\(k) vor pop")
+            pop()
+            for t in [2.0, 4.0, 4.0] { await sleep(t); report("\(k) nach pop") }
+        }
+        await sleep(4.0)
+        report("ENDE leak")
+    }
