@@ -0,0 +1,28 @@
+#!/bin/bash
+# B06-Sonde iOS: startet die App im Simulator mit Ablauf ios-orientation, Bilder bei Protokollmarken.
+set -u
+P=/private<sonde>
+U=$1; NAME=$2; URL=$3
+O=$P/probe/run/ios-$NAME
+rm -rf "$O"; mkdir -p "$O"
+echo "=== IOS $NAME $(date +%T)" >> $P/probe/run/mock.log
+SIMCTL_CHILD_B06_SCRIPT=ios-orientation SIMCTL_CHILD_B06_URL="$URL" \
+  xcrun simctl launch --terminate-running-process --console-pty "$U" lu.daumedia.MikaPlusPlayer.b06probe > "$O/console.log" 2>&1 &
+LP=$!
+declare -a TAGS=("player hochformat:" "vollbild an:" "vollbild aus:" "vorher querformat links:" "vollbild an aus links:" "vollbild aus nach links:" "vollbild an vor zurück:" "nach zurück:")
+declare -a DONE=(0 0 0 0 0 0 0 0)
+start=$(date +%s)
+while [ $(( $(date +%s) - start )) -lt 90 ]; do
+  for i in "${!TAGS[@]}"; do
+    if [ "${DONE[$i]}" = 0 ] && grep -q "B06 ${TAGS[$i]}" "$O/console.log" 2>/dev/null; then
+      xcrun simctl io "$U" screenshot "$O/$(printf '%02d' $i)-$(echo "${TAGS[$i]}" | tr ' :' '-_' | tr -d 'üä').png" > /dev/null 2>&1
+      DONE[$i]=1
+    fi
+  done
+  grep -q "B06 nach zurück +6s" "$O/console.log" 2>/dev/null && break
