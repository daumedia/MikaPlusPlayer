@@ -0,0 +1,29 @@
+#!/bin/bash
+# B06-Sonde: startet die Mac-App der Kopie mit einem Ablauf, fängt Unified Log und stdout/stderr ab,
+# erstellt angeforderte Fensterbilder (screencapture -x: ohne Ton).
+set -u
+P=/private<sonde>
+S=$1
+OUT=$P/probe/run/app-$S
+rm -rf "$OUT"; mkdir -p "$OUT/shots"
+APP=$P/dd/Build/Products/Debug/MikaPlusPlayer.app/Contents/MacOS/MikaPlusPlayer
+export B06_SCRIPT=$S B06_SHOTDIR=$OUT/shots B06_STORE=$OUT/probe.store
+echo "=== APP $S $(date +%T)" >> $P/probe/run/mock.log
+log stream --style compact --level debug --predicate 'process == "MikaPlusPlayer"' > "$OUT/unified.log" 2>&1 &
+LS=$!
+sleep 1
+"$APP" > "$OUT/stdout.log" 2>&1 &
+AP=$!
+shopt -s nullglob
+while kill -0 $AP 2>/dev/null; do
+  for f in "$OUT"/shots/*.req; do
+    id=$(cat "$f"); n=$(basename "$f" .req)
+    screencapture -x -o -l "$id" "$OUT/shots/$n.png" 2>>"$OUT/shots/errors.txt"
+    rm -f "$f"
+  done
+  sleep 0.05
+done
+wait $AP; echo "exit=$?" >> "$OUT/stdout.log"
+sleep 1
+kill $LS 2>/dev/null
+echo "=== APP $S ENDE $(date +%T)" >> $P/probe/run/mock.log
