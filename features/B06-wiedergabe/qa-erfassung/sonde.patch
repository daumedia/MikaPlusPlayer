+        // d) AVKit Live-HLS: Referenz fallen lassen ohne Pause
+        // e) VLC Live-TS: Referenz fallen lassen ohne Pause
+        var a: (any PlaybackEngine)? = PlaybackEngineFactory.engine(for: URL(string: "\(b)/livehls/t07a/index.m3u8")!)
+        var bb: (any PlaybackEngine)? = PlaybackEngineFactory.engine(for: URL(string: "\(b)/tslive/t07b.ts")!)
+        var c: (any PlaybackEngine)? = PlaybackEngineFactory.engine(for: URL(string: "\(b)/delay/4/tslive/t07c.ts")!)
+        var d: (any PlaybackEngine)? = PlaybackEngineFactory.engine(for: URL(string: "\(b)/livehls/t07d/index.m3u8")!)
+        var e: (any PlaybackEngine)? = PlaybackEngineFactory.engine(for: URL(string: "\(b)/tslive/t07e.ts")!)
+        weak var wa = a as AnyObject?, wb = bb as AnyObject?, wc = c as AnyObject?, wd = d as AnyObject?, we = e as AnyObject?
+        weak var pa = a.flatMap { avPlayer($0) }, pd = d.flatMap { avPlayer($0) }
+        weak var vb = bb.flatMap { vlcPlayer($0) }, vc = c.flatMap { vlcPlayer($0) }, ve = e.flatMap { vlcPlayer($0) }
+        for (i, x) in [a!, bb!, c!, d!, e!].enumerated() { host(x, index: i) }
+        a!.load(URL(string: "\(b)/livehls/t07a/index.m3u8")!)
+        bb!.load(URL(string: "\(b)/tslive/t07b.ts")!)
+        c!.load(URL(string: "\(b)/delay/4/tslive/t07c.ts")!)
+        d!.load(URL(string: "\(b)/livehls/t07d/index.m3u8")!)
+        e!.load(URL(string: "\(b)/tslive/t07e.ts")!)
+        try? await Task.sleep(nanoseconds: 500_000_000)
+        out("07c|pause() während des Ladens|state=\(name(c!.state))|\(detail(c!))")
+        c!.pause()
+        out("07c|nach pause()|isPaused=\(c!.isPaused)|\(detail(c!))")
+        _ = await watch([("07a", a!), ("07b", bb!), ("07c", c!), ("07d", d!), ("07e", e!)], seconds: 8)
+        out("07a|pause() wie onDisappear"); a!.pause()
+        out("07b|pause() wie onDisappear"); bb!.pause()
+        _ = await watch([("07a", a!), ("07b", bb!), ("07c", c!), ("07d", d!), ("07e", e!)], seconds: 20, detailEvery: 5)
+
+        // Referenzen fallen lassen: Fenster schließen (Ansicht weg), dann Engine-Variable nil
+        out("07|Fenster schließen + Referenzen fallen lassen: a, b, d, e (c bleibt)")
+        for w in windows { w.contentView = nil; w.orderOut(nil) }
+        windows.removeAll()
+        a = nil; bb = nil; d = nil; e = nil
+        for t in [0.5, 2.0, 5.0, 15.0] {
+            try? await Task.sleep(nanoseconds: UInt64((t == 0.5 ? 0.5 : t == 2.0 ? 1.5 : t == 5.0 ? 3.0 : 10.0) * 1_000_000_000))
+            out("07|+\(t)s|engineA=\(wa != nil) avPlayerA=\(pa != nil) rateA=\(pa?.rate ?? -1) | engineB=\(wb != nil) vlcB=\(vb != nil) | engineD=\(wd != nil) avPlayerD=\(pd != nil) rateD=\(pd?.rate ?? -1) | engineE=\(we != nil) vlcE=\(ve != nil)")
+            if let vb { out("07b|+\(t)s|vlc lebt: state=\(((vb.value(forKey: "state") as? NSNumber)?.intValue).map { Self.vlcStates[$0] } ?? "-") playing=\(vb.value(forKey: "playing") ?? "-")") }
+            if let ve { out("07e|+\(t)s|vlc lebt: state=\(((ve.value(forKey: "state") as? NSNumber)?.intValue).map { Self.vlcStates[$0] } ?? "-") playing=\(ve.value(forKey: "playing") ?? "-")") }
+        }
+        out("07c|am Ende|isPaused=\(c!.isPaused)|state=\(name(c!.state))|\(detail(c!))")
+        c = nil
+        try? await Task.sleep(nanoseconds: 3_000_000_000)
+        out("07c|nach Freigabe +3s|engineC=\(wc != nil) vlcC=\(vc != nil)")
+    }
+
+    // MARK: 08 · Roh-Zustände von VLC (Benachrichtigungen) und AVKit mit Byte-Range
+
+    func test08_VLCRohzustaendeUndAVKitMitRange() async {
+        let b = Self.base
+        let cases: [(String, String)] = [
+            ("08a-vlc-live", "\(b)/tslive/t08a.ts"),
+            ("08b-vlc-404", "\(b)/404/t08b.ts"),
+            ("08c-vlc-refused", "http://127.0.0.1:1/t08c.ts"),
+            ("08d-vlc-html", "\(b)/html/t08d.ts"),
+            ("08e-vlc-abbruch-8s", "\(b)/abort/8/tslive/t08e.ts"),
+            ("08f-vlc-datei-ende-120s-nicht-abgewartet", "\(b)/static/src.ts"),
+            ("08g-av-mp4-range", "\(b)/clip.mp4"),
+            ("08h-av-ts-datei-range", "\(b)/static/src.mp4"),
+        ]
+        var items: [(String, any PlaybackEngine)] = []
+        var tokens: [NSObjectProtocol] = []
+        for (i, c) in cases.enumerated() {
+            let url = URL(string: c.1)!
+            var e: any PlaybackEngine = PlaybackEngineFactory.engine(for: url)
+            if c.0 == "08h-av-ts-datei-range" { e = AVKitPlaybackEngine() }
+            host(e, index: i)
+            if let v = vlcPlayer(e) {
+                let label = c.0
+                tokens.append(NotificationCenter.default.addObserver(forName: Notification.Name("VLCMediaPlayerStateChanged"), object: v, queue: nil) { [weak self] note in
+                    let raw = ((note.object as? NSObject)?.value(forKey: "state") as? NSNumber)?.intValue ?? -1
+                    let name = raw >= 0 && raw < Self.vlcStates.count ? Self.vlcStates[raw] : "\(raw)"
+                    let thread = Thread.isMainThread ? "main" : "bg"
+                    MainActor.assumeIsolated { self?.out("\(label)|VLC-Benachrichtigung state=\(name) thread=\(thread)") }
+                })
+            }
+            out("\(c.0)|load|\(engineName(e))|\(c.1)")
+            e.load(url)
+            items.append((c.0, e))
+        }
+        _ = await watch(items, seconds: 30)
+        for t in tokens { NotificationCenter.default.removeObserver(t) }
+        for (label, e) in items {
+            out("\(label)|ENDE|state=\(name(e.state))|\(detail(e))")
+            e.pause()
+        }
+    }
+}
diff --git a/probe/mock_b06.py b/probe/mock_b06.py
new file mode 100644
index 0000000..7f0bd3f
--- /dev/null
+++ b/probe/mock_b06.py
@@ -0,0 +1,297 @@
+#!/usr/bin/env python3
+"""B06-Sonde: lokaler Stream-Mock (nur 127.0.0.1, nur stumme Testmedien).
+
+Routen (alles unter http://127.0.0.1:PORT):
+  /hls/vod.m3u8, /hls/segNNN.ts        HLS-VOD (statisch)
+  /clip.mp4                           MP4
+  /livehls/<beliebig>/index.m3u8       Live-HLS mit gleitendem Fenster (6 Segmente, 2 s)
+  /livehls/<beliebig>/segNNNNN.ts      Segmente dazu
+  /tslive/<beliebig>                  roher TS in Echtzeit, endlos (jede Endung / ohne Endung)
+  /404/<beliebig>                      HTTP 404
+  /html/<beliebig>                     HTTP 200 text/html
+  /hang/<beliebig>                     Verbindung annehmen, nie antworten (max. 900 s)
+  /delay/<sek>/<rest>                  <sek> warten, dann wie /<rest>
+  /abort/<sek>/tslive/<x>              TS in Echtzeit, nach <sek> Verbindung schließen
+  /abort/<sek>/livehls/<x>/...         Live-HLS, nach <sek> ab Serverstart jede Anfrage -> Verbindungsabbruch
+  /m3uplaylist/<x>.m3u                 M3U-Senderliste (kein HLS) mit zwei Einträgen
+  /live/<user>/<pass>/<id>.ts          Xtream-Form: roher TS in Echtzeit
+  /live/<user>/<pass>/<id>.m3u8        Xtream-Form: Live-HLS
+  /live/<user>/<pass>/404/<id>.ts      Xtream-Form: 404
+Protokoll: eine Zeile je Ereignis, Zeitstempel HH:MM:SS.mmm, Verbindungs-ID.
+"""
+import http.server, socketserver, socket, sys, os, time, threading, itertools, re
+
+PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 18906
+LOG = sys.argv[2] if len(sys.argv) > 2 else "mock.log"
+ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "media")
+START = time.time()
+TS = open(os.path.join(ROOT, "src.ts"), "rb").read()
+TS_DURATION = 120.0
+TS_RATE = len(TS) / TS_DURATION  # Bytes je Sekunde
+SEGS = sorted(f for f in os.listdir(os.path.join(ROOT, "hls")) if f.endswith(".ts"))
+ids = itertools.count(1)
+FIRST_SEEN = {}
+lock = threading.Lock()
+logf = open(LOG, "a", buffering=1)
+
+
+def log(msg):
+    now = time.time()
+    line = time.strftime("%H:%M:%S", time.localtime(now)) + ".%03d " % int((now % 1) * 1000) + msg
+    with lock:
+        logf.write(line + "\n")
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+    server_version = "B06Mock/1.0"
+
+    def log_message(self, *a):
+        pass
+
+    def setup(self):
+        super().setup()
+        self.cid = next(ids)
+
+    def handle(self):
+        log("conn=%d open peer=%s:%d" % (self.cid, *self.client_address))
+        try:
+            super().handle()
+        finally:
+            log("conn=%d close" % self.cid)
+
+    # ---- Hilfen
+    def head(self, code, ctype, length=None, extra=None):
+        self.send_response(code)
+        self.send_header("Content-Type", ctype)
+        if length is not None:
+            self.send_header("Content-Length", str(length))
+        for k, v in (extra or {}).items():
+            self.send_header(k, v)
+        self.end_headers()
+
+    def body(self, data):
+        try:
+            self.wfile.write(data)
+            self.wfile.flush()
+            return True
+        except (BrokenPipeError, ConnectionResetError) as e:
+            log("conn=%d write-error %s" % (self.cid, type(e).__name__))
+            return False
+
+    def realtime_ts(self, limit=None):
+        """Sendet src.ts in Echtzeit endlos. Protokolliert alle 5 s Menge und Stauzeit."""
+        self.head(200, "video/mp2t", extra={"Connection": "close"})
+        self.close_connection = True
+        sock = self.connection
+        sock.settimeout(1.0)
+        t0 = time.time()
+        sent = 0
+        stall = 0.0
+        last_report = t0
+        last_sent = 0
+        chunk = 1316 * 10
+        pos = 0
+        while True:
+            now = time.time()
+            if limit is not None and now - t0 >= limit:
+                log("conn=%d abort-after=%.1fs bytes=%d" % (self.cid, now - t0, sent))
+                try:
+                    sock.shutdown(socket.SHUT_RDWR)
+                except OSError:
+                    pass
+                return
+            if now - last_report >= 5.0:
+                log("conn=%d ts-progress t=%.0fs bytes=%d last5s=%d stall5s=%.1fs" %
+                    (self.cid, now - t0, sent, sent - last_sent, stall))
+                last_report = now
+                last_sent = sent
+                stall = 0.0
+            if now - t0 > 900:
+                log("conn=%d max-duration" % self.cid)
+                return
+            target = (now - t0) * TS_RATE + TS_RATE * 1.0  # 1 s Vorlauf
+            if sent >= target:
+                time.sleep(0.05)
+                continue
+            data = TS[pos:pos + chunk]
+            if len(data) < chunk:
+                data += TS[:chunk - len(data)]
+            view = memoryview(data)
+            while view:
+                try:
+                    n = sock.send(view)
+                    view = view[n:]
+                    sent += n
+                except socket.timeout:
+                    stall += 1.0
+                    if time.time() - last_report >= 5.0:
+                        log("conn=%d ts-progress t=%.0fs bytes=%d last5s=%d stall5s=%.1fs (blockiert)" %
+                            (self.cid, time.time() - t0, sent, sent - last_sent, stall))
+                        last_report = time.time()
+                        last_sent = sent
+                        stall = 0.0
+                    if time.time() - t0 > 900:
+                        return
+                except (BrokenPipeError, ConnectionResetError, OSError) as e:
+                    log("conn=%d client-closed after=%.1fs bytes=%d (%s)" % (self.cid, time.time() - t0, sent, type(e).__name__))
+                    return
+            pos = (pos + chunk) % len(TS)
+
+    def live_playlist(self, base_path):
+        seq = int((time.time() - START) / 2.0)
+        lines = ["#EXTM3U", "#EXT-X-VERSION:3", "#EXT-X-TARGETDURATION:2", "#EXT-X-MEDIA-SEQUENCE:%d" % seq]
+        for i in range(seq, seq + 6):
+            lines += ["#EXTINF:2.000000,", "seg%05d.ts" % i]
+        data = ("\n".join(lines) + "\n").encode()
+        self.head(200, "application/vnd.apple.mpegurl", len(data), {"Cache-Control": "no-cache"})
+        self.body(data)
+
+    def live_segment(self, name):
+        m = re.match(r"seg(\d+)\.ts$", name)
+        if not m:
+            return self.not_found()
+        idx = int(m.group(1)) % len(SEGS)
+        data = open(os.path.join(ROOT, "hls", SEGS[idx]), "rb").read()
+        self.head(200, "video/mp2t", len(data))
+        self.body(data)
+
+    def not_found(self):
+        data = b"<html><body><h1>404 Not Found</h1></body></html>"
+        self.head(404, "text/html", len(data))
+        self.body(data)
+
+    def static(self, rel, ctype):
+        path = os.path.join(ROOT, rel)
+        if not os.path.isfile(path):
+            return self.not_found()
+        data = open(path, "rb").read()
+        rng = self.headers.get("Range", "")
+        m = re.match(r"bytes=(\d*)-(\d*)$", rng.strip())
+        if m and (m.group(1) or m.group(2)):
+            start = int(m.group(1)) if m.group(1) else len(data) - int(m.group(2))
+            end = int(m.group(2)) if (m.group(1) and m.group(2)) else len(data) - 1
+            end = min(end, len(data) - 1)
+            part = data[start:end + 1]
+            self.head(206, ctype, len(part), {"Content-Range": "bytes %d-%d/%d" % (start, end, len(data)), "Accept-Ranges": "bytes"})
+            return self.body(part)
+        self.head(200, ctype, len(data), {"Accept-Ranges": "bytes"})
+        self.body(data)
+
+    # ---- Routing
+    def do_GET(self):
+        ua = self.headers.get("User-Agent", "")
+        rng = self.headers.get("Range", "")
+        log("conn=%d GET %s ua=%r range=%r" % (self.cid, self.path, ua, rng))
+        self.route(self.path.split("?")[0])
+
+    def route(self, path):
+        parts = [p for p in path.split("/") if p]
+        if not parts:
+            return self.not_found()
+        head = parts[0]
+        if head == "delay" and len(parts) >= 3:
+            secs = float(parts[1])
+            key = "/".join(parts[:-1])
+            with lock:
+                seen = key in FIRST_SEEN
+                FIRST_SEEN.setdefault(key, time.time())
+            if not seen:  # nur die erste Anfrage je Pfad verzögern (Segmente danach normal)
+                log("conn=%d delay %.0fs" % (self.cid, secs))
+                time.sleep(secs)
+            return self.route("/" + "/".join(parts[2:]))
+        if head == "abort" and len(parts) >= 3:
+            secs = float(parts[1])
+            rest = parts[2:]
+            if rest[0] == "tslive":
+                return self.realtime_ts(limit=secs)
+            if rest[0] == "livehls":
+                key = "/".join(parts[:4])
+                with lock:
+                    first = FIRST_SEEN.setdefault(key, time.time())
+                if time.time() - first >= secs:
+                    log("conn=%d abort-livehls (seit erster Anfrage %.0fs)" % (self.cid, time.time() - first))
+                    self.close_connection = True
+                    try:
+                        self.connection.shutdown(socket.SHUT_RDWR)
+                    except OSError:
+                        pass
+                    return
+                return self.route("/" + "/".join(rest))
+        if head == "hls":
+            ctype = "application/vnd.apple.mpegurl" if parts[-1].endswith(".m3u8") else "video/mp2t"
+            return self.static(os.path.join("hls", parts[-1]), ctype)
+        if head == "clip.mp4":
+            return self.static("clip.mp4", "video/mp4")
+        if head == "static" and len(parts) >= 2:
+            name = parts[-1]
+            if name.startswith("src."):
+                return self.static("src.ts", "video/mp2t")
+            return self.static(name, "application/octet-stream")
+        if head == "livehls":
+            if parts[-1].endswith(".m3u8") or parts[-1].endswith(".m3u"):
+                return self.live_playlist(path)
+            return self.live_segment(parts[-1])
+        if head == "tslive":
+            return self.realtime_ts()
+        if head == "404":
+            return self.not_found()
+        if head == "auth":
+            log("conn=%d auth-header=%r" % (self.cid, self.headers.get("Authorization", "")))
+            data = b"<html><body>401</body></html>"
+            self.head(401, "text/html", len(data), {"WWW-Authenticate": 'Basic realm="IPTV-Sonde"'})
+            return self.body(data)
+        if head == "403":
+            data = b"<html><body>403</body></html>"
+            self.head(403, "text/html", len(data))
+            return self.body(data)
+        if head == "html":
+            data = b"<!doctype html><html><head><title>Portal</title></head><body><p>Bitte anmelden</p></body></html>" * 20
+            self.head(200, "text/html; charset=utf-8", len(data))
+            return self.body(data)
+        if head == "hang":
+            log("conn=%d hang" % self.cid)
+            self.connection.settimeout(1.0)
+            t0 = time.time()
+            while time.time() - t0 < 900:
+                try:
+                    d = self.connection.recv(1)
+                    if d == b"":
+                        log("conn=%d hang-client-closed after=%.1fs" % (self.cid, time.time() - t0))
+                        self.close_connection = True
+                        return
+                except socket.timeout:
+                    continue
+                except OSError as e:
+                    log("conn=%d hang-client-closed after=%.1fs (%s)" % (self.cid, time.time() - t0, type(e).__name__))
+                    self.close_connection = True
+                    return
+            self.close_connection = True
+            return
+        if head == "m3uplaylist":
+            data = ("#EXTM3U\n#EXTINF:-1 tvg-id=\"a\",Sender A\nhttp://127.0.0.1:%d/hls/vod.m3u8\n"
+                    "#EXTINF:-1 tvg-id=\"b\",Sender B\nhttp://127.0.0.1:%d/clip.mp4\n" % (PORT, PORT)).encode()
+            self.head(200, "audio/x-mpegurl", len(data))
+            return self.body(data)
+        if head == "live" and len(parts) >= 4:
+            # Xtream-Form /live/<user>/<pass>/<id>.<ext>
+            if parts[3] == "404":
+                return self.not_found()
+            last = parts[-1]
+            if last.endswith(".m3u8"):
+                return self.live_playlist(path)
+            if re.match(r"seg\d+\.ts$", last):
+                return self.live_segment(last)
+            return self.realtime_ts()
+        return self.not_found()
+
+
+class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
+    daemon_threads = True
+    allow_reuse_address = True
+
+
+if __name__ == "__main__":
+    srv = Server(("127.0.0.1", PORT), Handler)
+    log("server start port=%d ts_rate=%.0f B/s segs=%d" % (PORT, TS_RATE, len(SEGS)))
+    srv.serve_forever()
