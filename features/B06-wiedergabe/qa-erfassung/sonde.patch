+    func name(_ s: PlaybackState) -> String {
+        switch s {
+        case .idle: return "idle"
+        case .loading: return "loading"
+        case .playing: return "playing"
+        case .failed(let m): return "failed(\(m))"
+        }
+    }
+
+    func child(_ obj: Any, _ label: String) -> Any? {
+        var m: Mirror? = Mirror(reflecting: obj)
+        while let cur = m {
+            if let c = cur.children.first(where: { $0.label == label }) { return c.value }
+            m = cur.superclassMirror
+        }
+        return nil
+    }
+
+    func avPlayer(_ e: any PlaybackEngine) -> AVPlayer? { child(e, "player") as? AVPlayer }
+    func vlcPlayer(_ e: any PlaybackEngine) -> NSObject? { child(e, "mediaPlayer") as? NSObject }
+
+    static let vlcStates = ["stopped", "opening", "buffering", "ended", "error", "playing", "paused", "esAdded"]
+
+    func detail(_ e: any PlaybackEngine) -> String {
+        if let p = avPlayer(e) {
+            let item = p.currentItem
+            let tcs: String
+            switch p.timeControlStatus {
+            case .paused: tcs = "paused"
+            case .playing: tcs = "playing"
+            case .waitingToPlayAtSpecifiedRate: tcs = "waiting(\(p.reasonForWaitingToPlay?.rawValue ?? "-"))"
+            @unknown default: tcs = "?"
+            }
+            let st: String
+            switch item?.status {
+            case .readyToPlay: st = "ready"
+            case .failed: st = "failed"
+            case .unknown: st = "unknown"
+            default: st = "nil"
+            }
+            let err = item?.error as NSError?
+            return "av rate=\(p.rate) tcs=\(tcs) item=\(st) vol=\(p.volume) muted=\(p.isMuted)"
+                + (err.map { " err=\($0.domain)#\($0.code)" } ?? "")
+        }
+        if let v = vlcPlayer(e) {
+            let raw = (v.value(forKey: "state") as? NSNumber)?.intValue ?? -1
+            let st = raw >= 0 && raw < Self.vlcStates.count ? Self.vlcStates[raw] : "\(raw)"
+            let playing = (v.value(forKey: "playing") as? NSNumber)?.boolValue ?? false
+            let audio = v.value(forKey: "audio") as? NSObject
+            let vol = (audio?.value(forKey: "volume") as? NSNumber)?.intValue
+            let muted = (audio?.value(forKey: "muted") as? NSNumber)?.boolValue
+            return "vlc state=\(st) isPlaying=\(playing) audio=\(audio == nil ? "nil" : "da") audio.volume=\(vol.map(String.init) ?? "-") audio.muted=\(muted.map { $0 ? "1" : "0" } ?? "-")"
+        }
+        return "?"
+    }
+
+    func engineName(_ e: any PlaybackEngine) -> String { String(describing: type(of: e)) }
+
+    /// Beobachtet mehrere Engines parallel und protokolliert jede Zustandsänderung mit Zeit seit Start.
+    func watch(_ items: [(String, any PlaybackEngine)], seconds: Double, step: Double = 0.1,
+               detailEvery: Double = 5) async -> [String: [(Double, String)]] {
+        var last: [String: String] = [:]
+        var log: [String: [(Double, String)]] = [:]
+        let start = Date()
+        var nextDetail = 0.0
+        while true {
+            let t = Date().timeIntervalSince(start)
+            for (label, e) in items {
+                let s = name(e.state)
+                if last[label] != s {
+                    last[label] = s
+                    log[label, default: []].append((t, s))
+                    out("\(label)|t=\(String(format: "%.1f", t))s|state=\(s)|\(detail(e))")
+                }
+            }
+            if t >= nextDetail {
+                for (label, e) in items { out("\(label)|t=\(String(format: "%.1f", t))s|tick|state=\(name(e.state))|\(detail(e))") }
+                nextDetail += detailEvery
+            }
+            if t >= seconds { break }
+            try? await Task.sleep(nanoseconds: UInt64(step * 1_000_000_000))
+        }
+        return log
+    }
+
+    /// Hängt die Videofläche der Engine in ein kleines Fenster (wie in der App eingebettet).
+    var windows: [NSWindow] = []
+    func host(_ e: any PlaybackEngine, index: Int) {
+        let size = CGSize(width: 240, height: 135)
+        let col = index % 6, row = index / 6
+        let w = NSWindow(contentRect: NSRect(x: 40 + CGFloat(col) * 250, y: 80 + CGFloat(row) * 170, width: size.width, height: size.height),
+                         styleMask: [.titled], backing: .buffered, defer: false)
+        w.isReleasedWhenClosed = false
+        w.title = "B06-Sonde \(index)"
+        w.contentView = NSHostingView(rootView: e.makePlayerView())
+        w.orderFront(nil)
+        windows.append(w)
+    }
+
+    override func tearDown() async throws {
+        for w in windows { w.contentView = nil; w.orderOut(nil) }
+        windows.removeAll()
+        try? await Task.sleep(nanoseconds: 300_000_000)
+    }
