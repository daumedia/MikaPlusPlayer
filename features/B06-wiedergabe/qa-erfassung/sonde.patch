+#if os(macOS)
+/// Realer Navigationsweg (ContentView → PlaylistsView → ChannelListView → PlayerView), bedient über Bedienungshilfen.
+@MainActor
+enum B06RealNav {
+    static func sleep(_ s: Double) async { try? await Task.sleep(nanoseconds: UInt64(s * 1_000_000_000)) }
+
+    static func elements(_ root: NSObject, depth: Int = 0, into out: inout [(NSObject, String, String)]) {
+        guard depth < 60 else { return }
+        let role = (root.accessibilityAttributeValue(.role) as? String) ?? ""
+        let texts = [NSAccessibility.Attribute.title, .description, .value, .help].compactMap { root.accessibilityAttributeValue($0) as? String }.filter { !$0.isEmpty }
+        out.append((root, role, texts.joined(separator: " | ")))
+        for c in (root.accessibilityAttributeValue(.children) as? [Any] ?? []).compactMap({ $0 as? NSObject }) {
+            elements(c, depth: depth + 1, into: &out)
+        }
+    }
+
+    static func all() -> [(NSObject, String, String)] {
+        var out: [(NSObject, String, String)] = []
+        for w in NSApp.windows where w.isVisible { elements(w, into: &out) }
+        return out
+    }
+
+    /// Drückt das erste Element, das den Text enthält (Buttons bevorzugt; sonst nächster Vorfahr mit Press-Aktion).
+    static func press(containing text: String, roles: [String] = ["AXButton", "AXLink", "AXCell", "AXGroup"]) -> Bool {
+        let list = all()
+        for role in roles {
+            if let hit = list.first(where: { $0.1 == role && $0.2.contains(text) }) {
+                let actions = (hit.0.accessibilityActionNames() as [NSAccessibility.Action]).map(\.rawValue)
+                B06Probe.log("realnav drücke \(role) '\(hit.2)' aktionen=\(actions)")
+                if actions.contains("AXPress") { hit.0.accessibilityPerformAction(.press); return true }
+            }
+        }
+        // Text-Element finden und Vorfahren mit AXPress drücken
+        if let textEl = list.first(where: { $0.2.contains(text) }) {
+            var cur: NSObject? = textEl.0
+            while let c = cur {
+                let actions = (c.accessibilityActionNames() as [NSAccessibility.Action]).map(\.rawValue)
+                if actions.contains("AXPress") {
+                    B06Probe.log("realnav drücke Vorfahr \((c.accessibilityAttributeValue(.role) as? String) ?? "?") von '\(textEl.2)'")
+                    c.accessibilityPerformAction(.press); return true
+                }
+                cur = c.accessibilityAttributeValue(.parent) as? NSObject
+            }
+        }
+        B06Probe.log("realnav nicht gefunden: '\(text)'")
+        return false
+    }
+
+    static func clickFallback() {
+        guard let w = NSApp.keyWindow ?? NSApp.windows.first(where: { $0.isVisible }) else { return }
+        B06Probe.log("realnav contentView=\(type(of: w.contentView!)) ax-children=\((w.contentView?.accessibilityChildren() ?? []).count)")
+    }
+
+    static func dump(_ tag: String) {
+        let list = all().filter { !$0.2.isEmpty || $0.1 == "AXButton" }.prefix(80)
+        B06Probe.log("realnav AX \(tag): " + list.map { "\($0.1)[\($0.2)]" }.joined(separator: " ; "))
+    }
+
+    static func shot(_ name: String) {
+        guard let dir = ProcessInfo.processInfo.environment["B06_SHOTDIR"], let w = NSApp.windows.first(where: { $0.isVisible }) else { return }
+        try? "\(w.windowNumber)".write(to: URL(fileURLWithPath: dir).appendingPathComponent("\(name).req"), atomically: true, encoding: .utf8)
+    }
+
+    /// Klick an Punkt (x, y von oben links im Inhaltsbereich des Fensters).
+    static func click(topLeft p: CGPoint) async {
+        guard let w = NSApp.windows.first(where: { $0.isVisible }) else { return }
+        if !w.isKeyWindow { NSApp.activate(ignoringOtherApps: true); w.makeKeyAndOrderFront(nil); await sleep(0.4) }
+        let h = w.contentView?.frame.height ?? w.frame.height
+        let loc = CGPoint(x: p.x, y: h - p.y)
+        for type in [NSEvent.EventType.leftMouseDown, .leftMouseUp] {
+            if let ev = NSEvent.mouseEvent(with: type, location: loc, modifierFlags: [], timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: w.windowNumber, context: nil, eventNumber: 0, clickCount: 1, pressure: 1) {
+                if w.isKeyWindow { NSApp.sendEvent(ev) } else { w.sendEvent(ev) }
+            }
+            await sleep(0.05)
+        }
+        B06Probe.log("realnav klick oben-links \(p) fenster=\(w.windowNumber) key=\(w.isKeyWindow) inhaltshöhe=\(h)")
+    }
+
+    static func run(context: ModelContext) async {
+        B06Probe.installBeepGuard()
+        let env = ProcessInfo.processInfo.environment
+        let p = Playlist(name: "Sonde-Liste")
+        context.insert(p)
+        let defs = [("Kanal HLS eins", "http://127.0.0.1:18906/livehls/real-1/index.m3u8"),
+                    ("Kanal HLS zwei", "http://127.0.0.1:18906/livehls/real-2/index.m3u8"),
+                    ("Kanal TS drei", "http://127.0.0.1:18906/tslive/real-3.ts")]
+        for (n, u) in defs {
+            let c = Channel(name: n, streamURL: URL(string: u)!, playlist: p, playlistID: p.id)
+            context.insert(c)
+        }
+        p.channelCount = defs.count
+        try? context.save()
+        await sleep(2)
+        NSApp.activate(ignoringOtherApps: true)
+        await sleep(1)
+        if let w = NSApp.windows.first(where: { $0.isVisible }) {
+            B06Probe.log("realnav fenster \(w.windowNumber) frame=\(w.frame) content=\(w.contentView?.frame ?? .zero)")
+        }
+        shot("real-00-playlists")
+        await sleep(1.5)
+        guard let px = Double(env["B06_PL_X"] ?? ""), let py = Double(env["B06_PL_Y"] ?? "") else {
+            B06Probe.log("realnav nur Bild (keine Koordinaten)"); await sleep(1); NSApp.terminate(nil); return
+        }
+        await click(topLeft: CGPoint(x: px, y: py))
+        await sleep(2.5)
+        shot("real-01-senderliste")
+        await sleep(1.5)
+        guard let cy0 = Double(env["B06_CH_Y0"] ?? ""), let dy = Double(env["B06_CH_DY"] ?? ""), let cx = Double(env["B06_CH_X"] ?? ""),
+              let bx = Double(env["B06_BACK_X"] ?? ""), let by = Double(env["B06_BACK_Y"] ?? "") else {
+            B06Probe.log("realnav nur bis Senderliste"); await sleep(1); NSApp.terminate(nil); return
+        }
+        let order = [(0, "Kanal HLS eins"), (1, "Kanal HLS zwei"), (0, "Kanal HLS eins"), (2, "Kanal TS drei"), (1, "Kanal HLS zwei")]
+        for (i, (idx, name)) in order.enumerated() {
+            B06Probe.log("realnav öffne \(name)")
+            let before = B06Probe.engines.count
+            await click(topLeft: CGPoint(x: cx, y: cy0 + Double(idx) * dy))
+            await sleep(6)
+            B06Probe.log("realnav im player (neue engine=\(B06Probe.engines.count > before)) engines: \(B06Probe.engineReport())")
+            if i == 0 { shot("real-02-player") }
+            await click(topLeft: CGPoint(x: bx, y: by))
+            for t in [2.0, 4.0, 6.0] { await sleep(t); B06Probe.log("realnav nach zurück (\(name)) engines: \(B06Probe.engineReport())") }
+            if i == 0 { shot("real-03-nach-zurueck") }
+        }
+        await sleep(2)
+        B06Probe.log("ENDE engines: \(B06Probe.engineReport())")
+        NSApp.terminate(nil)
+    }
+}
