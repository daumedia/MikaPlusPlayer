+    private func makeChannel(_ key: String, _ name: String, _ url: String, xtream: XtreamSecret? = nil, xtreamMissing: Bool = false) -> Channel {
+        let c = Channel(name: name, streamURL: URL(string: url)!)
+        if xtream != nil || xtreamMissing {
+            let p = Playlist(name: "Xtream-Sonde", sourceURL: URL(string: "http://127.0.0.1:18906/player_api.php"), isXtream: true, xtreamOutput: "mpegts")
+            context.insert(p)
+            if let xtream { try? XtreamCredentialStore.standard.save(xtream, for: p.id) }
+            c.playlist = p; c.playlistID = p.id
+        }
+        context.insert(c)
+        try? context.save()
+        channels[key] = c
+        return c
+    }
