+    /// Alle Beschriftungen im Fenster (jede Rolle), von oben nach unten.
+    @MainActor func texts(_ w: NSWindow) -> [(String, NSRect)] {
+        AX.wake(w)
+        return AX.all(w).filter { !AX.label($0).isEmpty && AX.role($0) != "AXWindow" }
+            .map { (AX.label($0), AX.frame($0)) }
+            .sorted { $0.1.midY > $1.1.midY }
