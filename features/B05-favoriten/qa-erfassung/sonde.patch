+    @MainActor func open<V: View>(_ view: V, _ c: ModelContainer, size: CGSize = CGSize(width: 760, height: 900), borderless: Bool = false) -> NSWindow {
+        let root = view.modelContainer(c).environment(MultiviewSession())
+        let w = NSWindow(contentRect: NSRect(origin: CGPoint(x: 60, y: 40), size: size),
+                         styleMask: borderless ? [.borderless] : [.titled, .closable, .resizable], backing: .buffered, defer: false)
+        w.isReleasedWhenClosed = false
+        let hv = NSHostingView(rootView: root)
+        hv.sizingOptions = []
+        w.contentView = hv
+        w.setContentSize(size)
+        w.makeKeyAndOrderFront(nil)
+        windows.append(w)
+        spin(0.8)
+        AX.wake(w)
+        spin(0.2)
+        return w
+    }
