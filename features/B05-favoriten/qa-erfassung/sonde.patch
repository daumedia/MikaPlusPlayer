+            var total = 0
+            for size in [1 << 20, 65_536, 4_096, 512, 1] {
+                let buf = [UInt8](repeating: 0, count: size)
+                while true {
+                    let n = buf.withUnsafeBytes { Darwin.write(fd, $0.baseAddress, size) }
+                    if n <= 0 { break }
