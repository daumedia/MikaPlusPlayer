+    func installRoutes() {
+        let r = routes
+        mock.handler = { req in
+            if let (status, body) = r.get(req.path) {
+                return .raw(status: status, contentType: "audio/x-mpegurl", body: body)
+            }
+            return .raw(status: 404, contentType: "text/plain", body: Data())
+        }
+    }
