+    /// Die Karte (NavigationLink) eines Senders. Im AX-Baum ist sie EIN Element mit dem Etikett „Name, Gruppe".
+    @MainActor func card(_ w: NSWindow, name: String, index: Int = 0) -> NSObject? {
+        AX.wake(w)
+        let cards = AX.all(w).filter { e in
+            let l = AX.text(e, "accessibilityLabel")
+            return (l == name || l.hasPrefix(name + ", ")) && AX.frame(e).width > 200
+        }.sorted { AX.frame($0).midY > AX.frame($1).midY }
+        return index < cards.count ? cards[index] : nil
+    }
+
+    @MainActor func cardNames(_ w: NSWindow) -> [String] {
+        AX.wake(w)
+        return AX.all(w).filter { AX.frame($0).width > 200 && AX.frame($0).height > 40 && AX.frame($0).height < 120 && !AX.text($0, "accessibilityLabel").isEmpty
+            && !["AXScrollArea", "AXGroup", "AXWindow", "AXToolbar"].contains(AX.role($0)) }
+            .sorted { AX.frame($0).midY > AX.frame($1).midY }
+            .map { AX.text($0, "accessibilityLabel") }
+    }
+
+    /// Bildschirmpunkt des Sterns: rechter Rand der Karte minus Innenabstand (14 pt) minus halbe Symbolbreite.
+    @MainActor func starPoint(_ w: NSWindow, name: String, index: Int = 0) -> NSPoint? {
+        guard let c = card(w, name: name, index: index) else { return nil }
+        let f = AX.frame(c)
+        return NSPoint(x: f.maxX - 24, y: f.midY)
+    }
+
+    @MainActor func clickScreen(_ pt: NSPoint, in window: NSWindow) {
+        let pWin = window.convertPoint(fromScreen: pt)
+        for type in [NSEvent.EventType.leftMouseDown, .leftMouseUp] {
+            let ev = NSEvent.mouseEvent(with: type, location: pWin, modifierFlags: [], timestamp: ProcessInfo.processInfo.systemUptime,
+                                        windowNumber: window.windowNumber, context: nil, eventNumber: 0, clickCount: 1, pressure: 1)!
+            window.sendEvent(ev)
+        }
+    }
+
+    /// Klickt den Stern der Karte. Rückgabe: ob die Karte gefunden wurde.
+    @discardableResult
+    @MainActor func clickStar(_ w: NSWindow, name: String, index: Int = 0) -> Bool {
+        guard let pt = starPoint(w, name: name, index: index) else { p("clickStar|karte nicht gefunden|\(name)"); return false }
+        clickScreen(pt, in: w)
+        return true
+    }
+
+    /// Farbe des Sterns aus dem gerenderten Bild: „akzent" (rot), „grau" oder „?".
+    @MainActor func starColor(_ w: NSWindow, name: String, index: Int = 0) -> String {
+        guard let pt = starPoint(w, name: name, index: index), let v = w.contentView,
+              let rep = v.bitmapImageRepForCachingDisplay(in: v.bounds) else { return "?" }
+        v.cacheDisplay(in: v.bounds, to: rep)
+        let pWin = w.convertPoint(fromScreen: pt)
+        let pView = v.convert(pWin, from: nil)
+        let scale = CGFloat(rep.pixelsWide) / v.bounds.width
+        var red = 0, gray = 0
+        for dx in -10...10 {
+            for dy in -10...10 {
+                let x = Int((pView.x + CGFloat(dx)) * scale)
+                let yFlipped = v.isFlipped ? pView.y + CGFloat(dy) : v.bounds.height - (pView.y + CGFloat(dy))
+                let y = Int(yFlipped * scale)
+                guard x >= 0, y >= 0, x < rep.pixelsWide, y < rep.pixelsHigh, let col = rep.colorAt(x: x, y: y)?.usingColorSpace(.sRGB) else { continue }
+                let r = col.redComponent, g = col.greenComponent, b = col.blueComponent
+                if r - max(g, b) > 0.25 { red += 1 }
+                else if abs(r - g) < 0.06 && abs(g - b) < 0.06 && r < 0.8 && r > 0.3 { gray += 1 }
+            }
+        }
+        return red > 8 ? "akzent(\(red)px)" : (gray > 8 ? "grau(\(gray)px)" : "?(r\(red)/g\(gray))")
+    }
+
+    @MainActor func describe(_ e: NSObject?) -> String {
+        guard let e else { return "nil" }
+        let help = AX.text(e, "accessibilityHelp")
+        return "role=\(AX.role(e))|label=\(AX.text(e, "accessibilityLabel"))|title=\(AX.text(e, "accessibilityTitle"))|value=\(AX.text(e, "accessibilityValue"))|help=\(help)|frame=\(Int(AX.frame(e).width))x\(Int(AX.frame(e).height))"
+    }
