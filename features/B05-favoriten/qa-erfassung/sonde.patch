+    nonisolated func sql(_ path: String, _ q: String) -> [[String]] {
+        var db: OpaquePointer?
+        guard sqlite3_open_v2(path, &db, SQLITE_OPEN_READONLY, nil) == SQLITE_OK else { sqlite3_close(db); return [["open-fehler"]] }
+        defer { sqlite3_close(db) }
+        var st: OpaquePointer?
+        guard sqlite3_prepare_v2(db, q, -1, &st, nil) == SQLITE_OK else { return [["prepare-fehler: \(String(cString: sqlite3_errmsg(db)))"]] }
+        defer { sqlite3_finalize(st) }
+        var rows: [[String]] = []
+        var rc = sqlite3_step(st)
+        while rc == SQLITE_ROW {
+            var r: [String] = []
+            for i in 0..<sqlite3_column_count(st) {
+                if let c = sqlite3_column_text(st, i) { r.append(String(cString: c)) } else { r.append("NULL") }
+            }
+            rows.append(r)
+            rc = sqlite3_step(st)
+        }
+        if rc != SQLITE_DONE { rows.append(["step-fehler \(rc): \(String(cString: sqlite3_errmsg(db)))"]) }
+        return rows
+    }
