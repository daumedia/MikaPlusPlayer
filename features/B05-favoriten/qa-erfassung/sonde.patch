+    // MARK: - 50 · Leistung: 17.000 / 34.000 Sender, 50 / 100 Favoriten
+
+    static let genres = ["Sport", "News", "Kino", "Doku", "Kinder", "Musik", "Serie", "Anime", "Reise", "Kochen", "Natur", "Talk",
+                         "Comedy", "Krimi", "Wetter", "Auto", "Tech", "Mode", "Kunst", "Gesundheit", "Religion", "Politik", "Wissen", "Jagd", "Fußball"]
+    static let prefixes = ["DE", "AT", "CH", "UK", "FR", "IT", "ES", "PL", "TR", "NL", "US", "AR"]
+
+    @MainActor func seedLarge(_ ctx: ModelContext, name: String, count: Int, favEvery: Int, offset: Int) throws -> Playlist {
+        let pl = Playlist(name: name)
+        ctx.insert(pl)
+        var batch: [Channel] = []
+        for i in 0..<count {
+            let pre = Self.prefixes[i % Self.prefixes.count]
+            let genre = Self.genres[(i / 12) % Self.genres.count]
+            let ch = Channel(name: "\(pre): \(genre) \(i % 100) \(["HD", "FHD", "SD", "4K"][i % 4])",
+                             streamURL: URL(string: "http://127.0.0.1:9/live/\(offset + i).ts")!,
+                             logoURL: nil, group: "\(pre) | \(genre)", tvgID: "\(genre.lowercased()).\(i % 100).\(pre.lowercased())",
+                             isFavorite: i % favEvery == 0, playlistID: pl.id)
+            ctx.insert(ch)
+            batch.append(ch)
+            if batch.count == 5_000 { pl.channels.append(contentsOf: batch); batch.removeAll(); try ctx.save() }
+        }
+        pl.channels.append(contentsOf: batch)
+        pl.channelCount = count
+        try ctx.save()
+        return pl
+    }
+
+    @MainActor func test50_Leistung() async throws {
+        let (c0, url) = try fileContainer("perf")
+        let t = try ms {
+            _ = try seedLarge(c0.mainContext, name: "Groß 1", count: 17_000, favEvery: 340, offset: 0)
+        }
+        p("t50|anlegen-17000|ms=\(Int(t))")
+
+        let favPred = #Predicate<Channel> { $0.isFavorite == true }
+        func measure(_ label: String) throws {
+            let schema = Schema([Playlist.self, Channel.self])
+            let c = try ModelContainer(for: schema, configurations: [ModelConfiguration(schema: schema, url: url)])
+            let ctx = c.mainContext
+            var n = 0
+            let cold = try ms { n = try ctx.fetch(FetchDescriptor(predicate: favPred, sortBy: [genericSort(\Channel.name)])).count }
+            var warm: [Double] = []
+            for _ in 0..<4 { warm.append(try ms { _ = try ctx.fetch(FetchDescriptor(predicate: favPred, sortBy: [genericSort(\Channel.name)])) }) }
+            var cnt = 0
+            let countMs = try ms { cnt = try ctx.fetchCount(FetchDescriptor(predicate: favPred)) }
+            let total = try ctx.fetchCount(FetchDescriptor<Channel>())
+            p("t50|abfrage|\(label)|sender=\(total)|favoriten=\(n)|count=\(cnt)|kaltMs=\(String(format: "%.1f", cold))|warmMs=\(warm.map { String(format: "%.1f", $0) }.joined(separator: ","))|countMs=\(String(format: "%.1f", countMs))")
+
+            // Schlüssel merken wie in refresh()
+            let pls = try ctx.fetch(FetchDescriptor<Playlist>(sortBy: [SortDescriptor(\.name)]))
+            if let big = pls.first {
+                var keys = Set<String>()
+                let km = ms { keys = Set(big.channels.filter(\.isFavorite).map(\.favoriteKey)) }
+                let km2 = ms { keys = Set(big.channels.filter(\.isFavorite).map(\.favoriteKey)) }
+                p("t50|refresh-schluessel-merken|\(label)|playlist=\(big.name)|schluessel=\(keys.count)|kaltMs=\(Int(km))|warmMs=\(Int(km2))")
+            }
+        }
+        try measure("17000")
+
+        // Anzeige: Favoriten-Tab öffnen, im Tab entfernen; Senderliste + Tab gleichzeitig, Stern in der Liste
+        let schema = Schema([Playlist.self, Channel.self])
+        let c = try ModelContainer(for: schema, configurations: [ModelConfiguration(schema: schema, url: url)])
+        let ctx = c.mainContext
+        let hb = Heartbeat(); hb.start()
+        let w = open(NavigationStack { FavoritesView() }, c, size: CGSize(width: 760, height: 900))
+        spin(0.5)
+        p("t50|tab-oeffnen|maxBlockMs=\(Int(hb.stopMaxGapMs()))|karten=\(cardNames(w).count)")
+        let firstFav = try XCTUnwrap(try ctx.fetch(FetchDescriptor(predicate: favPred, sortBy: [genericSort(\Channel.name)])).first)
+        let hb2 = Heartbeat(); hb2.start()
+        var syncMs = 0.0
+        syncMs = ms { clickStar(w, name: firstFav.name) }
+        spin(1.0)
+        p("t50|im-tab-entfernen|syncMs=\(Int(syncMs))|maxBlockMs=\(Int(hb2.stopMaxGapMs()))|favoriten=\(try ctx.fetchCount(FetchDescriptor(predicate: favPred)))")
+        firstFav.isFavorite = true
+        try ctx.save()
+        spin(0.5)
+
+        let pl = try XCTUnwrap(try ctx.fetch(FetchDescriptor<Playlist>()).first)
+        let list = open(NavigationStack { ChannelListView(playlist: pl) }, c, size: CGSize(width: 760, height: 900))
+        spin(1.0)
+        let listNames = cardNames(list).map { String($0.split(separator: ",").first ?? "") }.filter { $0.contains(": ") }
+        if let target = listNames.first(where: { n in !(pl.channels.first { $0.name == n }?.isFavorite ?? true) }) ?? listNames.first {
+            for round in 0..<2 {
+                let hb3 = Heartbeat(); hb3.start()
+                var sMs = 0.0
+                sMs = ms { clickStar(list, name: target) }
+                spin(1.0)
+                p("t50|stern-in-liste-mit-offenem-tab|runde=\(round)|ziel=\(target)|syncMs=\(Int(sMs))|maxBlockMs=\(Int(hb3.stopMaxGapMs()))")
+            }
+            w.close()
+            spin(0.5)
+            for round in 0..<2 {
+                let hb4 = Heartbeat(); hb4.start()
+                var sMs = 0.0
+                sMs = ms { clickStar(list, name: target) }
+                spin(1.0)
+                p("t50|stern-in-liste-ohne-tab|runde=\(round)|ziel=\(target)|syncMs=\(Int(sMs))|maxBlockMs=\(Int(hb4.stopMaxGapMs()))")
+            }
+        }
+        list.close()
+        spin(0.3)
+
+        // 34.000 Sender, 100 Favoriten
+        _ = try seedLarge(c0.mainContext, name: "Groß 2", count: 17_000, favEvery: 340, offset: 17_000)
+        try measure("34000")
+    }
