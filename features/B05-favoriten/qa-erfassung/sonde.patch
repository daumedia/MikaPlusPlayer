+    func m3u(_ es: [E]) -> String {
+        var s = "#EXTM3U\n"
+        for e in es {
+            var attrs = ""
+            if let t = e.tvg { attrs += " tvg-id=\"\(t)\"" }
+            if let g = e.group { attrs += " group-title=\"\(g)\"" }
+            s += "#EXTINF:-1\(attrs),\(e.name)\n\(e.url)\n"
+        }
+        return s
+    }
+
+    final class Routes: @unchecked Sendable {
+        private let lock = NSLock()
+        private var map: [String: (Int, Data)] = [:]
+        func set(_ path: String, _ status: Int, _ text: String) { lock.withLock { map[path] = (status, Data(text.utf8)) } }
+        func get(_ path: String) -> (Int, Data)? { lock.withLock { map[path] } }
+    }
+
+    let routes = Routes()
