+    final class Heartbeat {
+        var stamps: [Double] = []
+        var timer: Timer?
+        func start() {
+            stamps = [CACurrentMediaTime()]
+            timer = Timer(timeInterval: 0.005, repeats: true) { [weak self] _ in self?.stamps.append(CACurrentMediaTime()) }
+            RunLoop.main.add(timer!, forMode: .common)
+        }
+        func stopMaxGapMs() -> Double {
+            timer?.invalidate()
+            var maxGap = 0.0
+            if stamps.count > 1 { for i in 1..<stamps.count { maxGap = max(maxGap, stamps[i] - stamps[i - 1]) } }
+            return maxGap * 1000
+        }
+    }
