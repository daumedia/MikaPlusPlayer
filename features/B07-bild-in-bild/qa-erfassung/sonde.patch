diff -ruN -x .DS_Store a/Tests/B07ProbeTests.swift b/Tests/B07ProbeTests.swift
--- a/Tests/B07ProbeTests.swift	1970-01-01 01:00:00
+++ b/Tests/B07ProbeTests.swift	2026-09-15 23:47:42
@@ -0,0 +1,163 @@
+import XCTest
+import SwiftUI
+import AVKit
+import CoreGraphics
+@testable import MikaPlusPlayer
+
+/// B07-Sonde (nur Scratchpad-Kopie): beobachtet das PiP-Verhalten der Engines auf macOS
+/// gegen einen lokalen HLS-Server (127.0.0.1:18907).
+@MainActor
+final class B07ProbeTests: XCTestCase {
+    let hls = URL(string: "http://127.0.0.1:18907/hls/live.m3u8")!
+    let ts = URL(string: "http://127.0.0.1:18907/stream.ts")!
+
+    func log(_ s: String) { NSLog("B07T %@", s) }
+
+    @discardableResult
+    func waitUntil(_ timeout: TimeInterval, _ cond: () -> Bool) -> Bool {
+        let end = Date().addingTimeInterval(timeout)
+        while Date() < end {
+            if cond() { return true }
+            RunLoop.main.run(until: Date().addingTimeInterval(0.1))
+        }
+        return cond()
+    }
+
+    func pump(_ secs: TimeInterval) { RunLoop.main.run(until: Date().addingTimeInterval(secs)) }
+
+    func foreignWindows() -> [String] {
+        let info = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] ?? []
+        return info.compactMap { w in
+            let owner = w[kCGWindowOwnerName as String] as? String ?? "?"
+            let layer = w[kCGWindowLayer as String] as? Int ?? -1
+            let b = w[kCGWindowBounds as String] as? [String: Any] ?? [:]
+            let name = w[kCGWindowName as String] as? String ?? ""
+            return "\(owner)|layer=\(layer)|\(name)|\(b["Width"] ?? 0)x\(b["Height"] ?? 0)"
+        }
+    }
+
+    func host(_ engine: any PlaybackEngine) -> NSWindow {
+        let window = NSWindow(contentRect: NSRect(x: 100, y: 100, width: 640, height: 360),
+                              styleMask: [.titled, .closable, .resizable], backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        window.contentView = NSHostingView(rootView: engine.makePlayerView().frame(width: 640, height: 360))
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        return window
+    }
+
+    func testA_FactoryAndSupport() {
+        let a = PlaybackEngineFactory.engine(for: hls)
+        let t = PlaybackEngineFactory.engine(for: ts)
+        let m3u = PlaybackEngineFactory.engine(for: URL(string: "http://127.0.0.1:18907/x.m3u")!)
+        let mp4 = PlaybackEngineFactory.engine(for: URL(string: "http://127.0.0.1:18907/x.mp4")!)
+        let noExt = PlaybackEngineFactory.engine(for: URL(string: "http://127.0.0.1:18907/live/u/p/101")!)
+        log("factory m3u8=\(type(of: a)) ts=\(type(of: t)) m3u=\(type(of: m3u)) mp4=\(type(of: mp4)) noExt=\(type(of: noExt))")
+        log("supports m3u8=\(a.supportsPictureInPicture) ts=\(t.supportsPictureInPicture) isSupportedSystem=\(AVPictureInPictureController.isPictureInPictureSupported())")
+        t.setAutomaticPictureInPicture(true)
+        t.togglePictureInPicture()
+        log("ts after toggle active=\(t.isPictureInPictureActive)")
+        XCTAssertFalse(t.supportsPictureInPicture)
+    }
+
+    func testB_StartBeforeReady() {
+        let engine = AVKitPlaybackEngine()
+        let window = host(engine)
+        engine.load(hls)
+        engine.startPictureInPicture()
+        log("B immediately after start (before ready): state=\(engine.state) active=\(engine.isPictureInPictureActive)")
+        pump(3)
+        log("B 3s later: state=\(engine.state) active=\(engine.isPictureInPictureActive) possible=\(engine.probePiPController?.isPictureInPicturePossible ?? false)")
+        engine.pause()
+        window.close()
+    }
+
+    func testC_StartStopAndAfterStop() {
+        let before = Set(foreignWindows())
+        let engine = AVKitPlaybackEngine()
+        let window = host(engine)
+        engine.load(hls)
+        XCTAssertTrue(waitUntil(15) { engine.state == .playing }, "not playing")
+        let possible = waitUntil(15) { engine.probePiPController?.isPictureInPicturePossible == true }
+        log("C playing, possible=\(possible) rate=\(engine.probePlayer.rate)")
+        engine.startPictureInPicture()
+        let active = waitUntil(15) { engine.isPictureInPictureActive }
+        pump(2)
+        let during = Set(foreignWindows()).subtracting(before)
+        log("C active=\(active) rate=\(engine.probePlayer.rate) isPaused=\(engine.isPaused) newWindows=\(during.sorted())")
+        // PiP-Fenster: Pause über den Player simulieren (entspricht dem Pause-Knopf im PiP-Fenster)
+        engine.probePlayer.pause()
+        pump(1)
+        log("C after player.pause() in PiP: engine.isPaused=\(engine.isPaused) rate=\(engine.probePlayer.rate)")
+        engine.probePlayer.play()
+        pump(1)
+        engine.togglePictureInPicture()
+        let stopped = waitUntil(10) { !engine.isPictureInPictureActive }
+        pump(2)
+        log("C after toggle(stop): stopped=\(stopped) rate=\(engine.probePlayer.rate) tcs=\(engine.probePlayer.timeControlStatus.rawValue) isPaused=\(engine.isPaused) windows=\(Set(foreignWindows()).subtracting(before).sorted())")
+        engine.pause()
+        window.close()
+    }
+
+    func testD_ReleaseEngineWhilePiPActive() {
+        let before = Set(foreignWindows())
+        weak var weakEngine: AVKitPlaybackEngine?
+        weak var weakPlayer: AVPlayer?
+        weak var weakController: AVPictureInPictureController?
+        var window: NSWindow?
+        do {
+            let engine = AVKitPlaybackEngine()
+            weakEngine = engine
+            weakPlayer = engine.probePlayer
+            window = host(engine)
+            engine.load(hls)
+            XCTAssertTrue(waitUntil(15) { engine.state == .playing })
+            waitUntil(15) { engine.probePiPController?.isPictureInPicturePossible == true }
+            weakController = engine.probePiPController
+            engine.startPictureInPicture()
+            XCTAssertTrue(waitUntil(15) { engine.isPictureInPictureActive })
+            pump(2)
+            log("D active before release, windows=\(Set(foreignWindows()).subtracting(before).sorted())")
+        }
+        // Wie beim Zurücknavigieren: Ansicht weg (onDisappear pausiert NICHT, weil PiP aktiv), Engine-Referenz fällt.
+        window?.contentView = nil
+        window?.close()
+        window = nil
+        pump(5)
+        log("D 5s after release: engine=\(weakEngine != nil) player=\(weakPlayer != nil) controller=\(weakController != nil) rate=\(weakPlayer?.rate ?? -1) windows=\(Set(foreignWindows()).subtracting(before).sorted())")
+        pump(5)
+        log("D 10s after release: engine=\(weakEngine != nil) player=\(weakPlayer != nil) controller=\(weakController != nil) rate=\(weakPlayer?.rate ?? -1) windows=\(Set(foreignWindows()).subtracting(before).sorted())")
+        weakPlayer?.pause()
+        weakController?.stopPictureInPicture()
+        pump(2)
+    }
+
+    func testE_TwoEnginesSecondStart() {
+        let a = AVKitPlaybackEngine(); let wa = host(a); a.load(hls)
+        let b = AVKitPlaybackEngine(); let wb = host(b); b.load(hls)
+        wb.setFrameOrigin(NSPoint(x: 800, y: 100))
+        XCTAssertTrue(waitUntil(15) { a.state == .playing && b.state == .playing })
+        waitUntil(15) { a.probePiPController?.isPictureInPicturePossible == true && b.probePiPController?.isPictureInPicturePossible == true }
+        a.startPictureInPicture()
+        XCTAssertTrue(waitUntil(15) { a.isPictureInPictureActive })
+        pump(1)
+        log("E A active=\(a.isPictureInPictureActive); B possible=\(b.probePiPController?.isPictureInPicturePossible ?? false)")
+        b.startPictureInPicture()
+        pump(5)
+        log("E after B start: A active=\(a.isPictureInPictureActive) rateA=\(a.probePlayer.rate) B active=\(b.isPictureInPictureActive) rateB=\(b.probePlayer.rate)")
+        a.stopPictureInPicture(); b.stopPictureInPicture()
+        pump(2)
+        a.pause(); b.pause(); wa.close(); wb.close()
+    }
+
+    func testF_LoadFailsThenStart() {
+        let engine = AVKitPlaybackEngine()
+        let window = host(engine)
+        engine.load(URL(string: "http://127.0.0.1:18907/missing.m3u8")!)
+        waitUntil(15) { if case .failed = engine.state { return true } else { return false } }
+        engine.startPictureInPicture()
+        pump(2)
+        log("F failed stream: state=\(engine.state) active=\(engine.isPictureInPictureActive) supports=\(engine.supportsPictureInPicture)")
+        window.close()
+    }
+}
