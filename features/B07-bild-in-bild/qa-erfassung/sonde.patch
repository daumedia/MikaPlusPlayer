+}
+
+
+/// B07-Sonde (nur Scratchpad-Kopie): legt einen Sender an und steuert Navigation/PiP zeitgesteuert.
+struct B07ProbeRoot: View {
+    @Environment(\.modelContext) private var context
+    @State private var path: [Channel] = []
+    @State private var channel: Channel?
+
+    var body: some View {
+        NavigationStack(path: $path) {
+            List {
+                if let channel { NavigationLink(channel.name, value: channel) }
+            }
+            .navigationTitle("B07-Sonde")
+            .navigationDestination(for: Channel.self) { PlayerView(channel: $0) }
+        }
+        .task {
+            let env = ProcessInfo.processInfo.environment
+            let url = URL(string: env["B07_URL"]!)!
+            let c = Channel(name: "B07 Testsender", streamURL: url)
+            context.insert(c)
+            channel = c
+            path = [c]
+            NSLog("B07 harness: pushed player for %@", url.absoluteString)
+            func after(_ key: String, _ action: @escaping () -> Void) {
+                guard let v = env[key], let secs = Double(v) else { return }
+                DispatchQueue.main.asyncAfter(deadline: .now() + secs) { action() }
+            }
+            after("B07_PIP_AFTER") { NotificationCenter.default.post(name: .init("b07.togglePiP"), object: nil) }
+            after("B07_POP_AFTER") { NSLog("B07 harness: pop"); path = [] }
+            after("B07_REPUSH_AFTER") { NSLog("B07 harness: repush"); path = [c] }
+            Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { _ in
+                #if os(macOS)
+                let info = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] ?? []
+                let pip = info.filter { ($0[kCGWindowOwnerName as String] as? String ?? "").contains("Bild") }
+                NSLog("B07 harness: PiP-Systemfenster sichtbar=%d", pip.count)
+                #endif
+            }
+            after("B07_STOP_AFTER") { NSLog("B07 harness: stopPictureInPicture on first engine (alive=%d)", AVKitPlaybackEngine.probeFirst?.engine == nil ? 0 : 1); AVKitPlaybackEngine.probeFirst?.engine?.stopPictureInPicture() }
+            after("B07_PIP2_AFTER") { NotificationCenter.default.post(name: .init("b07.togglePiP"), object: nil) }
+        }
+    }
 }
