+        with lock:
+            if user and limit["max"] > 0:
+                open_for_user = [s for s in streams.values() if not s["closed"] and s.get("user") == user]
+                if len(open_for_user) >= limit["max"]:
+                    over = True
+                else:
+                    over = False
+            else:
+                over = False
+        if over:
+            log("LIMIT|%s|%s|abgewiesen" % (self.client(), self.path))
