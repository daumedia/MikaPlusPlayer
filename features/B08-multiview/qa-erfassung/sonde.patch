+// B08-SONDE — nur in der Scratchpad-Kopie, nie im Repository.
+// Zeitgesteuerter Lauf der echten App (Szenen WindowGroup + Window("Multiview")). Gestartet über
+// B08_PROBE=1 B08_SCENARIO=<name>. In-Memory-Datenbank und Test-Schlüsselbunddienst (AppEnvironment-Patch).
+// Bedienung über synthetische Maus-/Tastaturereignisse an die eigenen Fenster; unbehandelte Tasten
+// werden per B08Beep abgefangen (kein Warnton). Alle Streams ohne Tonspur.
+#if os(macOS)
+import SwiftUI
+import SwiftData
+import AppKit
+
+struct B08ProbeHook: View {
+    @Environment(MultiviewSession.self) private var multiview
+    @Environment(\.openWindow) private var openWindow
+    @Environment(\.modelContext) private var context
+
+    var body: some View {
+        Color.clear.frame(width: 0, height: 0)
+            .task {
+                await B08Driver.startOnce(multiview: multiview, openWindow: openWindow, context: context)
+            }
+    }
+}
+
+@MainActor
+final class B08Driver {
+    nonisolated(unsafe) static var started = false
+    static var current: B08Driver?
+
+    let mv: MultiviewSession
+    let openWindow: OpenWindowAction
+    let ctx: ModelContext
+    let scenario: String
+    var xtream: Playlist?
+    var m3u: Playlist?
+    var weakEngines: [B08Weak] = []
+
+    init(mv: MultiviewSession, openWindow: OpenWindowAction, ctx: ModelContext, scenario: String) {
+        self.mv = mv; self.openWindow = openWindow; self.ctx = ctx; self.scenario = scenario
+    }
+
+    static func startOnce(multiview: MultiviewSession, openWindow: OpenWindowAction, context: ModelContext) async {
+        guard !started else { return }
+        started = true
+        let scenario = ProcessInfo.processInfo.environment["B08_SCENARIO"] ?? "S1"
+        let d = B08Driver(mv: multiview, openWindow: openWindow, ctx: context, scenario: scenario)
+        current = d
+        B08Beep.install()
+        B08Log.w("=== APP|szenario=\(scenario)|pid=\(ProcessInfo.processInfo.processIdentifier)|bundle=\(Bundle.main.bundleIdentifier ?? "?")|schlüsselbundDienst=\(XtreamCredentialStore.standard.service)|beepAbfangIn=\(B08Beep.installedIn)")
+        await B08Mock.control("reset=1&limit=0&shift=0")
+        await d.run()
+    }
+
+    // MARK: - Hilfen
+
+    func spin(_ s: TimeInterval) async { try? await Task.sleep(nanoseconds: UInt64(s * 1_000_000_000)) }
+
+    var mainWindows: [NSWindow] {
+        NSApp.windows.filter { $0.isVisible && $0.title != "Multiview" && $0.contentView != nil && $0.frame.width > 300 }
+            .sorted { $0.windowNumber < $1.windowNumber }
+    }
+    var mvWindow: NSWindow? { NSApp.windows.first { $0.title == "Multiview" && $0.isVisible } }
+    var mvWindowAny: NSWindow? { NSApp.windows.first { $0.title == "Multiview" } }
+
+    func waitFor(_ what: String, timeout: TimeInterval = 8, _ cond: () -> Bool) async -> Bool {
+        let end = Date().addingTimeInterval(timeout)
+        while Date() < end {
+            if cond() { return true }
+            await spin(0.1)
+        }
+        B08Log.w("WARTEN|\(what)|Zeitüberschreitung")
+        return false
+    }
+
+    func lsof() -> String {
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/usr/sbin/lsof")
+        p.arguments = ["-nP", "-a", "-p", "\(ProcessInfo.processInfo.processIdentifier)", "-iTCP@127.0.0.1:18908", "-sTCP:ESTABLISHED"]
+        let pipe = Pipe()
+        p.standardOutput = pipe
+        p.standardError = Pipe()
+        do { try p.run() } catch { return "lsof-fehler" }
+        p.waitUntilExit()
+        let out = String(data: pipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8) ?? ""
+        let lines = out.split(separator: "\n").dropFirst()
+        return "tcpVerbindungenZumMock=\(lines.count)"
+    }
+
+    func state(_ tag: String, filter: String = "") async {
+        B08Log.w("\(tag)|\(B08Inspect.session(mv))")
+        B08Log.w("\(tag)|mock|\(await B08Mock.summary(filter: filter))|\(lsof())")
+    }
+
+    func windowsLine(_ tag: String) {
+        let list = NSApp.windows.filter { $0.isVisible }.map { "\($0.title)[\(Int($0.frame.width))x\(Int($0.frame.height))\($0.isKeyWindow ? ",key" : "")\($0.isMiniaturized ? ",min" : "")]" }
+        B08Log.w("\(tag)|fenster=\(list)")
+    }
+
+    // Accessibility (im eigenen Prozess)
+    func cards(_ w: NSWindow) -> [NSObject] {
+        B08AX.wake(w)
+        return B08AX.all(w).filter { B08AX.frame($0).width > 200 && B08AX.frame($0).height > 40 && B08AX.frame($0).height < 120
+            && !B08AX.text($0, "accessibilityLabel").isEmpty && !["AXScrollArea", "AXGroup", "AXWindow", "AXToolbar"].contains(B08AX.text($0, "accessibilityRole")) }
+    }
+    func card(_ w: NSWindow, _ name: String) -> NSObject? {
+        cards(w).first { let l = B08AX.text($0, "accessibilityLabel"); return l == name || l.hasPrefix(name + ", ") }
+    }
+    func clickCardBody(_ w: NSWindow, _ name: String) -> Bool {
+        guard let c = card(w, name) else { B08Log.w("AX|karte fehlt|\(name)|karten=\(cards(w).map { B08AX.text($0, "accessibilityLabel") })"); return false }
+        let f = B08AX.frame(c)
+        B08AX.click(at: NSPoint(x: f.minX + 120, y: f.midY), in: w)
+        return true
+    }
+    /// ⊞ sitzt links neben dem Stern: Kartenrand 14 pt, Stern ≈ 20 pt, Abstand 12 pt, ⊞ ≈ 22 pt → Mitte ≈ maxX − 57.
+    func clickPlus(_ w: NSWindow, _ name: String, offset: CGFloat = 57) -> Bool {
+        guard let c = card(w, name) else { B08Log.w("AX|karte fehlt|\(name)"); return false }
+        let f = B08AX.frame(c)
+        B08AX.click(at: NSPoint(x: f.maxX - offset, y: f.midY), in: w)
+        return true
+    }
+    func cardHelp(_ w: NSWindow, _ name: String) -> String {
+        guard let c = card(w, name) else { return "-" }
+        return B08AX.describe(c)
+    }
+    func pressLabeled(_ w: NSWindow, _ label: String, role: String? = nil) -> Bool {
+        B08AX.wake(w)
+        guard let e = B08AX.all(w).first(where: { (B08AX.text($0, "accessibilityLabel") == label || B08AX.text($0, "accessibilityTitle") == label)
+            && (role == nil || B08AX.text($0, "accessibilityRole") == role) }) else {
+            B08Log.w("AX|element fehlt|\(label)")
+            return false
+        }
+        let sel = NSSelectorFromString("accessibilityPerformPress")
+        guard e.responds(to: sel), let imp = e.method(for: sel) else { return false }
+        typealias F = @convention(c) (AnyObject, Selector) -> Bool
+        return unsafeBitCast(imp, to: F.self)(e, sel)
+    }
+    func removeButtons(_ w: NSWindow) -> [NSObject] {
+        B08AX.wake(w)
+        return B08AX.all(w).filter { B08AX.text($0, "accessibilityHelp") == "Stream entfernen" && B08AX.text($0, "accessibilityRole") == "AXButton" }
+    }
+    func picker(_ w: NSWindow) -> NSSegmentedControl? {
+        let roots = [w.contentView?.superview, w.contentView].compactMap { $0 }
+        for r in roots {
+            if let s = r.b08AllSubviews().compactMap({ $0 as? NSSegmentedControl }).first { return s }
+        }
+        return nil
+    }
+    func pickerLine(_ tag: String) {
+        guard let w = mvWindow else { B08Log.w("\(tag)|picker|kein Multiview-Fenster"); return }
+        if let p = picker(w) {
+            B08Log.w("\(tag)|picker|enabled=\(p.isEnabled)|selected=\(p.selectedSegment)|labels=\((0..<p.segmentCount).map { p.label(forSegment: $0) ?? "" })|session.layout=\(mv.layout.rawValue)")
+        } else {
+            B08Log.w("\(tag)|picker|nicht gefunden")
+        }
+    }
+    func selectLayout(_ index: Int) {
+        guard let w = mvWindow, let p = picker(w) else { B08Log.w("LAYOUT|picker fehlt"); return }
+        // Klick auf das Segment (Fensterkoordinaten)
+        let segWidth = p.bounds.width / CGFloat(max(1, p.segmentCount))
+        let local = NSPoint(x: segWidth * (CGFloat(index) + 0.5), y: p.bounds.midY)
+        let inWindow = p.convert(local, to: nil)
+        B08AX.click(windowPoint: inWindow, in: w)
+        B08Log.w("LAYOUT|klick auf Segment \(index)|enabled=\(p.isEnabled)|danach session.layout=\(mv.layout.rawValue)")
+    }
+
+    func hitChain(_ w: NSWindow, screen pt: NSPoint) -> String {
+        let pWin = w.convertPoint(fromScreen: pt)
+        guard let top = w.contentView?.superview else { return "-" }
+        var v = top.hitTest(pWin)
+        var names: [String] = []
+        while let vv = v, names.count < 7 { names.append(String(describing: type(of: vv))); v = vv.superview }
+        return names.joined(separator: " < ")
+    }
+
+    func trackEngines() {
+        for s in mv.slots where !weakEngines.contains(where: { $0.object === s.engine }) {
+            weakEngines.append(B08Weak(s.engine, s.channel.name))
+        }
+    }
+    func enginesLine(_ tag: String) {
+        B08Log.w("\(tag)|engines|" + weakEngines.map { w in
+            guard let e = w.object as? any PlaybackEngine else { return "\(w.label)=freigegeben" }
+            return "\(w.label)=lebt(isPaused=\(e.isPaused),state=\(B08Inspect.state(e)))"
+        }.joined(separator: " "))
+    }
+
+    func importAll() async {
+        let importer = PlaylistImporter(modelContext: ctx)
+        do {
+            m3u = try await importer.importFromURL(B08Mock.base + "/m3u/mix.m3u", name: "M3U MV")
+            xtream = try await importer.importFromXtream(XtreamCredentials(host: B08Mock.host, username: "qa-user", password: "qa-pass-b08"), output: .mpegts, name: "Xtream MV")
+            B08Log.w("IMPORT|m3u=\(m3u?.channelCount ?? -1)|xtream=\(xtream?.channelCount ?? -1)|xtreamStreamURLs=\(xtream?.channels.map(\.streamURL.absoluteString).sorted() ?? [])")
+        } catch {
+            B08Log.w("IMPORT|fehler|\(error.localizedDescription)")
+        }
+    }
+
+    func xch(_ n: Int) -> Channel? { xtream?.channels.first { $0.name == "MV Sender \(n)" } }
+    func mch(_ name: String) -> Channel? { m3u?.channels.first { $0.name == name } }
+
+    /// Dieselbe Aktion wie der ⊞-Button (`ChannelRowView.multiviewButton`).
+    func plusAction(_ c: Channel?) {
+        guard let c else { B08Log.w("PLUS|sender fehlt"); return }
+        mv.add(c)
+        openWindow(id: "multiview")
+        trackEngines()
+    }
+
+    func shot(_ w: NSWindow?, _ name: String) {
+        guard let w else { B08Log.w("SHOT|\(name)|kein Fenster"); return }
+        B08Shot.window(w, name)
+    }
+
+    func closeMultiviewViaButton(_ tag: String) async {
+        guard let w = mvWindow else { B08Log.w("\(tag)|kein Multiview-Fenster"); return }
+        B08Log.w("\(tag)|schließe Multiview über den roten Fensterknopf")
+        w.standardWindowButton(.closeButton)?.performClick(nil)
+        await spin(0.5)
+    }
+
+    func finish() async {
+        try? XtreamCredentialStore.standard.deleteAll()
+        B08Log.w("ENDE|szenario=\(scenario)|beepEreignisse=\(B08Beep.events)")
+        await spin(0.3)
+        NSApp.terminate(nil)
+    }
+
+    func mainWindowNavigateToPlaylist(_ w: NSWindow, _ name: String) async {
+        _ = clickCardBody(w, name)
+        _ = await waitFor("Senderliste \(name)") { w.title == name }
+        await spin(1.0)
+    }
+
+    // MARK: - Szenarien
+
+    func run() async {
+        NSApp.activate(ignoringOtherApps: true)
+        await spin(1.5)
+        await importAll()
+        await spin(1.0)
+        switch scenario {
+        case "S1": await s1()
+        case "S2": await sGridRemoveViaX()
+        case "S3": await sGridCloseWindow()
+        case "S4": await sFocusRemoveAllViaX()
+        case "S5": await sDeletePlaylist(layout: .grid)
+        case "S6": await sDeletePlaylist(layout: .focus)
+        case "S7": await sRefreshPlaylist()
+        case "S8": await sErrorsAndLimit()
+        case "S9": await sGridRemoveLastOfTwo()
+        case "S10": await sFocusClick()
+        case "S11": await sFocusVideo(tag: "S11", channels: [xch(101), xch(102), xch(103)])
+        case "S12": await sFocusVideo(tag: "S12", channels: [mch("M3U HLS A"), mch("M3U HLS B")])
+        case "S13": await sEmptyStateMenuMissingCredentials()
+        case "S14": await sGridCloseWithOne()
+        case "S15": await sQuitInGrid()
+        default: B08Log.w("unbekanntes Szenario")
+        }
+        await finish()
+    }
+
