+#!/bin/zsh
+# B08-Sonde: startet die App-Kopie (eigene Bundle-ID, In-Memory-DB) mit einem Szenario und sammelt Absturzberichte.
+set -u
+cd <sonde>
+name=$1
+limit=${2:-300}
+APP=dd/Build/Products/Debug/MikaPlusPlayer.app/Contents/MacOS/MikaPlusPlayer
+marker=evidence/.marker-$name
+touch $marker
+sleep 1
+echo "B08PROBE|--- APP-LAUF $name $(date '+%H:%M:%S')" >> evidence/probe.log
+B08_PROBE=1 B08_SCENARIO=$name "$APP" -ApplePersistenceIgnoreState YES > evidence/app-$name.stderr 2>&1 &
+pid=$!
+i=0
+while kill -0 $pid 2>/dev/null; do
+  sleep 1; i=$((i+1))
+  if [ $i -ge $limit ]; then echo "timeout nach ${limit}s"; kill $pid; break; fi
+done
+wait $pid
+code=$?
+echo "B08PROBE|--- APP-LAUF $name beendet exit=$code nach ${i}s" >> evidence/probe.log
+echo "exit=$code nach ${i}s"
+sleep 10
+for f in $(find ~/Library/Logs/DiagnosticReports -maxdepth 1 -name "MikaPlusPlayer*.ips" -newer $marker 2>/dev/null); do
+  if grep -q "lu.daumedia.MikaPlusPlayer.b08probe" "$f"; then
+    echo "ABSTURZBERICHT: $f"
+    cp "$f" evidence/crash-$name-$(basename $f)
+  fi
+done
+rm -f $marker
