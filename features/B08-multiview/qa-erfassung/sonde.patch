+@MainActor
+enum B08Inspect {
+    static func child(_ o: Any, _ label: String) -> Any? {
+        var m: Mirror? = Mirror(reflecting: o)
+        while let mm = m {
+            if let c = mm.children.first(where: { $0.label == label }) { return c.value }
+            m = mm.superclassMirror
+        }
+        return nil
+    }
+
+    static func kind(_ e: any PlaybackEngine) -> String {
+        if e is AVKitPlaybackEngine { return "AVKit" }
+        if e is VLCPlaybackEngine { return "VLC" }
+        return String(describing: type(of: e))
+    }
+
+    static func state(_ e: any PlaybackEngine) -> String {
+        switch e.state {
+        case .idle: return "idle"
+        case .loading: return "loading"
+        case .playing: return "playing"
+        case .failed(let m): return "failed(\(m))"
+        }
+    }
+
+    /// Innenzustand des eigentlichen Players (nicht nur der Engine-Flags).
+    static func low(_ e: any PlaybackEngine) -> String {
+        if let p = child(e, "player") as? AVPlayer {
+            let st: String
+            switch p.currentItem?.status {
+            case .readyToPlay: st = "ready"
+            case .failed: st = "failed"
+            case .unknown: st = "unknown"
+            default: st = "nil"
+            }
+            return "avPlayer.isMuted=\(p.isMuted) volume=\(p.volume) rate=\(p.rate) item=\(st)"
+        }
+        if let mp = child(e, "mediaPlayer") as? VLCMediaPlayer {
+            let audio: String
+            if let a = mp.audio {
+                audio = "audio.isMuted=\(a.isMuted) audio.volume=\(a.volume) audioTracks=\(mp.numberOfAudioTracks)"
+            } else {
+                audio = "audio=nil"
+            }
+            return "vlc.isPlaying=\(mp.isPlaying) vlc.state=\(VLCMediaPlayerStateToString(mp.state)) \(audio)"
+        }
+        return "?"
+    }
+
+    static func slot(_ s: MultiviewSession.Slot, index: Int, focus: Int) -> String {
+        let e = s.engine
+        return "[\(index)\(index == focus ? "*" : "")] \(s.channel.name) \(kind(e)) state=\(state(e)) isMuted=\(e.isMuted) isPaused=\(e.isPaused) vol=\(e.volume) | \(low(e))"
+    }
+
+    static func session(_ s: MultiviewSession) -> String {
+        var parts = ["slots=\(s.slots.count) focusedIndex=\(s.focusedIndex) canAddMore=\(s.canAddMore) layout=\(s.layout.rawValue)"]
+        for (i, sl) in s.slots.enumerated() { parts.append(Self.slot(sl, index: i, focus: s.focusedIndex)) }
+        return parts.joined(separator: "\n        ")
+    }
+}
