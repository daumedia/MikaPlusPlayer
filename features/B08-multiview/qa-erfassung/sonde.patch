+        with lock:
+            conn_seq += 1
+            cid = conn_seq
+            st = dict(id=cid, path=self.path, client=self.client(), opened=now(), bytes=0,
+                      last_progress=now(), closed=None, reason=None, user=user)
+            streams[cid] = st
+        self.rec(200)
+        log("OPEN|#%d|%s|%s" % (cid, self.client(), self.path))
+        self.send_response(200)
+        self.send_header("Content-Type", "video/mp2t")
+        self.send_header("Connection", "close")
+        self.send_header("Cache-Control", "no-cache")
+        self.end_headers()
+        self.close_connection = True
+        size = os.path.getsize(fp)
+        duration = 300.0 if "ts300" in fp else 120.0
+        rate = size / duration  # Bytes pro Sekunde
+        chunk = int(rate * 0.1) // 188 * 188
+        reason = "?"
+        try:
+            with open(fp, "rb") as f:
+                # 2 s Vorlauf sofort, dann Echtzeit
+                pre = f.read(int(rate * 2) // 188 * 188)
+                self.wfile.write(pre)
