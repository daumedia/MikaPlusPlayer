+#!/usr/bin/env python3
+"""B08-Sonde: lokaler Stream-Mock (nur 127.0.0.1, nur stumme Medien, erfundene Zugangsdaten).
+
+Pfade
+  /player_api.php                 Xtream-Panel (qa-user / qa-pass-b08), 4 Live-Sender
+  /live/<u>/<p>/<id>.ts           Xtream-MPEG-TS, endlos im Echtzeittakt (ts300.ts, ohne Tonspur)
+  /live/<u>/<p>/<id>.m3u8         Xtream-HLS (Live-Playlist aus hls/)
+  /live/<u>/<p>/seg*.ts           HLS-Segmente zu obigem
+  /ts/<name>.ts                   MPEG-TS endlos (ohne Tonspur)
+  /tsa/<name>.ts                  MPEG-TS mit stummer Tonspur (anullsrc, -91 dB)
+  /hls/<name>/live.m3u8, seg*.ts  HLS live (ohne Tonspur)
+  /err404/...                     immer 404
+  /abort/<name>.ts                sendet 4 s, trennt dann hart
+  /hang/<name>.ts                 nimmt an, antwortet nie
+  /stats                          JSON: offene Verbindungen, Anfragen je Pfad
+  /control?limit=N|reset=1        Verbindungslimit je Xtream-Benutzer (0 = aus)
+"""
+import json, os, socket, sys, threading, time, re
+from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
+from urllib.parse import urlparse, parse_qs, unquote
+
+BASE = os.path.dirname(os.path.abspath(__file__))
+MEDIA = os.path.join(BASE, "media")
+HLS = os.path.join(BASE, "hls")
+LOG = open(os.path.join(BASE, "mock.log"), "a", buffering=1)
+PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 18908
+
+lock = threading.Lock()
+conn_seq = 0
+streams = {}      # id -> dict(path, client, opened, bytes, last_progress, closed, reason)
+requests = []     # (t, client, method, path, status)
+limit = {"max": 0}
+hls_abort_first = {}
+shift = {"on": 0}
+T0 = time.time()
+
+
+def now():
+    return time.time()
+
+
+def log(msg):
+    LOG.write("MOCK|%.3f|%s\n" % (now(), msg))
+
+
+class H(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, *a):
+        pass
+
+    def client(self):
+        return "%s:%d" % self.client_address
+
+    def rec(self, status):
+        with lock:
+            requests.append((now(), self.client(), self.command, self.path, status))
+        log("REQ|%s|%s|%s|%d" % (self.client(), self.command, self.path, status))
+
+    def send_simple(self, status, body=b"", ctype="text/plain", extra=None):
+        self.rec(status)
+        self.send_response(status)
+        self.send_header("Content-Type", ctype)
+        self.send_header("Content-Length", str(len(body)))
+        self.send_header("Cache-Control", "no-cache")
+        for k, v in (extra or {}).items():
+            self.send_header(k, v)
+        self.end_headers()
+        if self.command != "HEAD":
+            try:
+                self.wfile.write(body)
+            except OSError:
+                pass
+
+    def do_HEAD(self):
+        self.do_GET()
+
+    def do_GET(self):
+        u = urlparse(self.path)
+        path = unquote(u.path)
+        q = parse_qs(u.query)
+        if path == "/stats":
+            return self.stats()
+        if path == "/control":
+            with lock:
+                if "limit" in q:
+                    limit["max"] = int(q["limit"][0])
+                if "shift" in q:
+                    shift["on"] = int(q["shift"][0])
+                if "reset" in q:
+                    requests.clear()
+                    hls_abort_first.clear()
+                    for k in [k for k, s in streams.items() if s["closed"]]:
+                        del streams[k]
+            log("CONTROL|%s" % u.query)
+            return self.send_simple(200, b"ok")
+        if path == "/player_api.php":
+            return self.panel(q)
+        if path == "/m3u/mix.m3u":
+            body = "#EXTM3U\n"
+            entries = [("M3U HLS A", "/hls/m3ua/live.m3u8"), ("M3U HLS B", "/hls/m3ub/live.m3u8"), ("M3U TS C", "/ts/m3uc.ts"),
+                       ("M3U 404 HLS", "/err404/m3ud/live.m3u8"), ("M3U 404 TS", "/err404/m3ue.ts"), ("M3U Abbruch TS", "/abort/m3uf.ts")]
+            for n, pth in entries:
+                body += '#EXTINF:-1 group-title="Sonde",%s\nhttp://127.0.0.1:%d%s\n' % (n, PORT, pth)
+            return self.send_simple(200, body.encode(), "audio/x-mpegurl")
+        if path.startswith("/err404/"):
+            return self.send_simple(404, b"not found")
+        if path.startswith("/hang/"):
+            self.rec(0)
+            log("HANG|%s|%s" % (self.client(), path))
+            try:
+                while True:
+                    time.sleep(1)
+                    self.connection.settimeout(0.01)
+                    try:
+                        if self.connection.recv(1) == b"":
+                            break
+                    except socket.timeout:
+                        pass
+                    except OSError:
+                        break
+            finally:
+                log("HANGCLOSED|%s|%s" % (self.client(), path))
+            self.close_connection = True
+            return
+        m = re.match(r"^/live/([^/]+)/([^/]+)/(.+)$", path)
+        if m:
+            user, pw, rest = m.group(1), m.group(2), m.group(3)
+            if user != "qa-user" or pw != "qa-pass-b08":
+                return self.send_simple(401, b"auth")
+            if rest.endswith(".m3u8"):
+                return self.file(os.path.join(HLS, "live.m3u8"), "application/vnd.apple.mpegurl")
+            if rest.startswith("seg") and rest.endswith(".ts"):
+                return self.file(os.path.join(HLS, rest), "video/mp2t")
+            if rest.endswith(".ts"):
+                return self.ts_stream(os.path.join(MEDIA, "ts300.ts"), user=user)
+            return self.send_simple(404)
+        if path.startswith("/ts/") and path.endswith(".ts"):
+            return self.ts_stream(os.path.join(MEDIA, "ts300.ts"))
+        if path.startswith("/tsa/") and path.endswith(".ts"):
+            return self.ts_stream(os.path.join(MEDIA, "ts120_silentaudio.ts"))
+        if path.startswith("/abort/") and path.endswith(".ts"):
+            return self.ts_stream(os.path.join(MEDIA, "ts300.ts"), abort_after=4.0)
+        m = re.match(r"^/hlsabort/([^/]+)/(.+)$", path)
+        if m:
+            with lock:
+                first = hls_abort_first.setdefault(m.group(1), now())
+            if now() - first > 6.0:
+                return self.send_simple(404, b"gone")
+            name = m.group(2)
+            if name.endswith(".m3u8"):
+                return self.file(os.path.join(HLS, "live.m3u8"), "application/vnd.apple.mpegurl")
+            return self.file(os.path.join(HLS, os.path.basename(name)), "video/mp2t")
+        m = re.match(r"^/hls/([^/]+)/(.+)$", path)
+        if m:
+            name = m.group(2)
+            if name.endswith(".m3u8"):
+                return self.file(os.path.join(HLS, "live.m3u8"), "application/vnd.apple.mpegurl")
+            return self.file(os.path.join(HLS, os.path.basename(name)), "video/mp2t")
+        return self.send_simple(404, b"unknown")
+
+    def file(self, fp, ctype):
+        try:
+            with open(fp, "rb") as f:
+                data = f.read()
+        except OSError:
+            return self.send_simple(404, b"gone")
+        return self.send_simple(200, data, ctype)
+
+    def panel(self, q):
+        user = q.get("username", [""])[0]
+        pw = q.get("password", [""])[0]
+        action = q.get("action", [None])[0]
+        if action is None:
+            ok = 1 if (user == "qa-user" and pw == "qa-pass-b08") else 0
+            body = {"user_info": {"auth": ok, "status": "Active", "max_connections": "1"}, "server_info": {"url": "127.0.0.1"}}
+        elif action == "get_live_categories":
+            body = [{"category_id": "1", "category_name": "Test"}]
+        elif action == "get_live_streams":
+            off = 100 if shift["on"] else 0
+            body = [{"stream_id": i + off, "name": "MV Sender %d" % i, "category_id": "1", "stream_icon": "", "epg_channel_id": ""} for i in range(101, 105)]
+        else:
+            body = []
+        return self.send_simple(200, json.dumps(body).encode(), "application/json")
+
+    def ts_stream(self, fp, user=None, abort_after=None):
