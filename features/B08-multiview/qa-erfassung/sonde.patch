+            log("CLOSE|#%d|%s|%s|%s|bytes=%d|dauer=%.1fs" % (cid, self.client(), self.path, reason, st["bytes"], st["closed"] - st["opened"]))
+
+    def stats(self):
+        t = now()
+        with lock:
+            open_streams = [dict(id=s["id"], path=s["path"], client=s["client"], age=round(t - s["opened"], 1), bytes=s["bytes"],
+                                 idle=round(t - s["last_progress"], 1)) for s in streams.values() if not s["closed"]]
