+/// Fängt den Systemwarnton ab: `-[NSResponder noResponderFor:]` ruft bei `keyDown:` `NSBeep()`
+/// (per Disassembly belegt). Ersetzt die Methode in allen Klassen, die sie implementieren – ohne
+/// das Original aufzurufen. Es entsteht also kein Ton; gezählt wird, wie oft er entstanden wäre.
+final class B08Beep {
+    nonisolated(unsafe) static var events: [String] = []
+    nonisolated(unsafe) static var installedIn: [String] = []
+
+    nonisolated(unsafe) static var imp: IMP?
+
+    /// Ersetzt `noResponderFor:` in NSResponder (Basis, per Disassembly: ruft NSBeep bei keyDown:).
+    static func install() {
+        guard imp == nil else { return }
+        let block: @convention(block) (AnyObject, Selector) -> Void = { obj, eventSelector in
+            B08Beep.events.append("\(NSStringFromSelector(eventSelector))@\(type(of: obj))")
+        }
+        let newImp = imp_implementationWithBlock(block)
+        imp = newImp
+        patch(NSResponder.self)
+    }
+
+    /// Findet in der Klassenkette die Klasse, die `noResponderFor:` selbst implementiert, und ersetzt dort.
+    static func patch(_ start: AnyClass) {
+        guard let newImp = imp else { return }
+        let sel = NSSelectorFromString("noResponderFor:")
+        var cls: AnyClass? = start
+        while let c = cls {
+            var mc: UInt32 = 0
+            if let methods = class_copyMethodList(c, &mc) {
+                for j in 0..<Int(mc) where method_getName(methods[j]) == sel {
+                    if method_getImplementation(methods[j]) != newImp {
+                        method_setImplementation(methods[j], newImp)
+                        installedIn.append(NSStringFromClass(c))
+                    }
+                }
+                free(methods)
+            }
+            cls = class_getSuperclass(c)
+        }
+    }
+
+    /// Vor dem Senden von Tasten: alle Objekte der Responder-Kette prüfen und ggf. nachpatchen.
+    @MainActor
+    static func coverResponderChain(of window: NSWindow) -> [String] {
+        var chain: [String] = []
+        var r: NSResponder? = window.firstResponder
+        var guardCount = 0
+        while let rr = r, guardCount < 40 {
+            patch(type(of: rr))
+            chain.append(String(describing: type(of: rr)))
+            r = rr.nextResponder
+            guardCount += 1
+        }
+        patch(type(of: window))
+        patch(type(of: NSApp!))
+        if let d = NSApp.delegate as? NSObject { patch(type(of: d)) }
+        return chain
+    }
+}
