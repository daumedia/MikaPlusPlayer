+@MainActor
+enum B08Shot {
+    /// Aufnahme genau eines Fensters dieses Prozesses (inkl. Videoebenen).
+    static func window(_ w: NSWindow, _ name: String) {
+        if let img = CGWindowListCreateImage(.null, .optionIncludingWindow, CGWindowID(w.windowNumber), [.boundsIgnoreFraming, .bestResolution]) {
+            let rep = NSBitmapImageRep(cgImage: img)
+            if let data = rep.representation(using: .png, properties: [:]) {
+                try? data.write(to: B08Log.dir.appendingPathComponent("\(name).png"))
+                B08Log.w("SHOT|\(name)|\(img.width)x\(img.height)|fenster=\(w.title)")
+                return
+            }
+        }
+        B08Log.w("SHOT|\(name)|fehlgeschlagen")
+    }
+
+    /// Anteil (fast) schwarzer Pixel im linken, mittleren Bereich des Fensters (Fläche des großen Streams im Fokus-Layout).
+    static func blackRatioBigArea(_ w: NSWindow) -> Double {
+        guard let img = CGWindowListCreateImage(.null, .optionIncludingWindow, CGWindowID(w.windowNumber), [.boundsIgnoreFraming, .nominalResolution]) else { return -1 }
+        let rep = NSBitmapImageRep(cgImage: img)
+        let wpx = rep.pixelsWide, hpx = rep.pixelsHigh
+        var black = 0, total = 0
+        let x0 = Int(Double(wpx) * 0.05), x1 = Int(Double(wpx) * 0.65)
+        let y0 = Int(Double(hpx) * 0.30), y1 = Int(Double(hpx) * 0.85)
+        var y = y0
+        while y < y1 {
+            var x = x0
+            while x < x1 {
+                if let c = rep.colorAt(x: x, y: y)?.usingColorSpace(.sRGB) {
+                    total += 1
+                    if c.redComponent < 0.06 && c.greenComponent < 0.06 && c.blueComponent < 0.06 { black += 1 }
+                }
+                x += 12
+            }
+            y += 12
+        }
+        return total == 0 ? -1 : Double(black) / Double(total)
+    }
+}
