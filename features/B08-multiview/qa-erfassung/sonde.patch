+    /// Fokus per Klick auf eine Kachel: App aktiv, Fenster Key, Klick mit Mausbewegung und Zeitabstand.
+    func sFocusClick() async {
+        for n in 101...103 { plusAction(xch(n)) }
+        _ = await waitFor("Multiview") { self.mvWindow != nil }
+        guard let w = mvWindow else { return }
+        w.setFrame(NSRect(x: 840, y: 120, width: 960, height: 600), display: true)
+        NSApp.activate(ignoringOtherApps: true)
+        w.makeKeyAndOrderFront(nil)
+        await spin(4)
+        B08Log.w("S10|app aktiv=\(NSApp.isActive)|mvKey=\(w.isKeyWindow)")
+        await state("S10|vorher")
+        let btns = removeButtons(w)
+        let bigX = btns.max { B08AX.frame($0).midX < B08AX.frame($1).midX }
+        let small = btns.filter { $0 !== bigX }.sorted { B08AX.frame($0).midY > B08AX.frame($1).midY }
+        guard small.count >= 2 else { B08Log.w("S10|kleine Kacheln fehlen"); return }
+        let f = B08AX.frame(small[1])
+        let screenPt = NSPoint(x: f.midX - 110, y: f.midY - 70)
+        let pWin = w.convertPoint(fromScreen: screenPt)
+        func ev(_ t: NSEvent.EventType, _ ts: TimeInterval) -> NSEvent? {
+            NSEvent.mouseEvent(with: t, location: pWin, modifierFlags: [], timestamp: ts, windowNumber: w.windowNumber,
+                               context: nil, eventNumber: Int.random(in: 1...10000), clickCount: t == .mouseMoved ? 0 : 1, pressure: t == .leftMouseUp ? 0 : 1)
+        }
+        let t0 = ProcessInfo.processInfo.systemUptime
+        if let m = ev(.mouseMoved, t0) { w.sendEvent(m) }
+        await spin(0.1)
+        if let d = ev(.leftMouseDown, t0 + 0.1) { w.sendEvent(d) }
+        await spin(0.08)
+        if let u = ev(.leftMouseUp, t0 + 0.18) { w.sendEvent(u) }
+        await spin(1.0)
+        B08Log.w("S10|klick mit Zeitabstand auf zweite kleine Kachel|trefferKette=\(hitChain(w, screen: screenPt))|focusedIndex=\(mv.focusedIndex)")
+        if mv.focusedIndex == 0 {
+            // Gegenprobe über NSApp.sendEvent statt Fenster
+            let t1 = ProcessInfo.processInfo.systemUptime
+            if let d = ev(.leftMouseDown, t1) { NSApp.sendEvent(d) }
+            await spin(0.08)
+            if let u = ev(.leftMouseUp, t1 + 0.08) { NSApp.sendEvent(u) }
+            await spin(1.0)
+            B08Log.w("S10|klick über NSApp.sendEvent|focusedIndex=\(mv.focusedIndex)")
+        }
+        await state("S10|nachher")
+        shot(w, "s10-fokus-klick")
+        await closeMultiviewViaButton("S10|ende")
+        await spin(2)
+    }
