+                    st["bytes"] += len(pre); st["last_progress"] = now()
+                start = now()
+                sent_time = 2.0
+                while True:
+                    if abort_after is not None and now() - start >= abort_after:
+                        reason = "server-abbruch"
+                        try:
+                            self.connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, b"\x01\x00\x00\x00\x00\x00\x00\x00")
+                        except OSError:
