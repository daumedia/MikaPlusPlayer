+    @MainActor
+    private func contextMenu(_ w: NSWindow, row: String, perform title: String? = nil) async -> [String] {
+        guard let content = w.contentView else { return [] }
+        AX.wake(w)
+        await UIHarness.spin(0.2)
+        guard let el = AX.all(content).first(where: { AX.label($0) == row }) ?? AX.all(content).first(where: { AX.label($0).contains(row) }) else {
+            B03Log.w("T14|kontextmenue|zeile nicht gefunden: \(row)")
+            return []
+        }
+        let f = AX.frame(el)
+        let pt = w.convertPoint(fromScreen: NSPoint(x: f.midX, y: f.midY))
+        let box = B03MenuBox()
+        let obs = NotificationCenter.default.addObserver(forName: NSMenu.didBeginTrackingNotification, object: nil, queue: nil) { note in
+            guard let menu = note.object as? NSMenu else { return }
+            box.menu = menu
+            box.shown += 1
+            box.titles = menu.items.map { $0.isSeparatorItem ? "—" : $0.title }
+            DispatchQueue.main.async { menu.cancelTracking() }
+        }
+        defer { NotificationCenter.default.removeObserver(obs) }
+        let ts = ProcessInfo.processInfo.systemUptime
+        if let down = NSEvent.mouseEvent(with: .rightMouseDown, location: pt, modifierFlags: [], timestamp: ts, windowNumber: w.windowNumber,
+                                         context: nil, eventNumber: 0, clickCount: 1, pressure: 1) {
+            w.sendEvent(down)
+        }
+        await UIHarness.spin(0.3)
+        B03Log.w("T14|kontextmenue|\(row)|punkt=\(pt)|menues=\(box.shown)|eintraege=\(box.titles)|nochUebersicht=\(rowNames(w).contains("MIKA+PLAYER · PLAYLISTS"))")
+        if let title, let menu = box.menu, let idx = menu.items.firstIndex(where: { $0.title == title }) {
+            menu.performActionForItem(at: idx)
+            B03Log.w("T14|kontextmenue|\(row)|ausgefuehrt=\(title)")
+        }
+        return box.titles
+    }
+
+    @MainActor
+    private func busyCount(_ w: NSWindow) -> Int {
+        guard let content = w.contentView else { return -1 }
+        AX.wake(w)
+        return AX.all(content).filter { AX.role($0).contains("ProgressIndicator") || AX.role($0).contains("BusyIndicator") }.count
+    }
+
+    @MainActor
+    private func rowNames(_ w: NSWindow) -> [String] {
+        guard let content = w.contentView else { return [] }
+        AX.wake(w)
+        return AX.all(content).map(AX.label).filter { !$0.isEmpty }
+    }
