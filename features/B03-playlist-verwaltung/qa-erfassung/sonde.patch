+enum B03 {
+    static func sqliteRows(_ path: String, _ sql: String) -> [String] {
+        var db: OpaquePointer?
+        guard sqlite3_open_v2(path, &db, SQLITE_OPEN_READONLY, nil) == SQLITE_OK else { sqlite3_close(db); return ["<open failed>"] }
+        defer { sqlite3_close(db) }
+        var stmt: OpaquePointer?
+        guard sqlite3_prepare_v2(db, sql, -1, &stmt, nil) == SQLITE_OK else {
+            return ["<prepare failed: \(String(cString: sqlite3_errmsg(db)))>"]
+        }
+        defer { sqlite3_finalize(stmt) }
+        var rows: [String] = []
+        while sqlite3_step(stmt) == SQLITE_ROW {
+            var cols: [String] = []
+            for i in 0..<sqlite3_column_count(stmt) {
+                if let c = sqlite3_column_text(stmt, i) { cols.append(String(cString: c)) } else { cols.append("NULL") }
+            }
+            rows.append(cols.joined(separator: ","))
+        }
+        return rows
+    }
+
+    static func dbSummary(_ url: URL) -> String {
+        let p = url.path
+        let q: [(String, String)] = [
+            ("ZPLAYLIST", "SELECT count(*) FROM ZPLAYLIST"),
+            ("ZCHANNEL", "SELECT count(*) FROM ZCHANNEL"),
+            ("ohneBeziehung", "SELECT count(*) FROM ZCHANNEL WHERE ZPLAYLIST IS NULL"),
+            ("favoriten", "SELECT count(*) FROM ZCHANNEL WHERE ZISFAVORITE = 1"),
+            ("channelCounts", "SELECT group_concat(ZNAME || '=' || ZCHANNELCOUNT, ';') FROM ZPLAYLIST")
+        ]
+        return q.map { "\($0.0)=\(sqliteRows(p, $0.1).joined(separator: "/"))" }.joined(separator: "|")
+    }
+
+    @MainActor
+    static func describe(_ p: Playlist, _ ctx: ModelContext) -> String {
+        let pid = p.id
+        let db = (try? ctx.fetchCount(FetchDescriptor<Channel>(predicate: #Predicate { $0.playlistID == pid }))) ?? -1
+        let favs = p.channels.filter(\.isFavorite).map(\.name).sorted()
+        return "name=\(p.name)|channelCount=\(p.channelCount)|beziehung=\(p.channels.count)|dbPlaylistID=\(db)|favoriten=\(favs)|createdAt=\(B03Log.ts(p.createdAt))|lastRefreshed=\(p.lastRefreshed.map(B03Log.ts) ?? "nil")|sourceURL=\(p.sourceURL?.absoluteString ?? "nil")|xtreamOutput=\(p.xtreamOutput ?? "nil")|isRemote=\(p.isRemote)|isXtream=\(p.isXtream)"
+    }
+
+    static func footprintMB() -> Double {
+        var info = task_vm_info_data_t()
+        var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<integer_t>.size)
+        let kr = withUnsafeMutablePointer(to: &info) {
+            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+                task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+            }
+        }
+        return kr == KERN_SUCCESS ? Double(info.phys_footprint) / 1_048_576 : -1
+    }
+
+    static var cacheDB: URL {
+        FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent(Bundle.main.bundleIdentifier ?? "?")
+            .appendingPathComponent("Cache.db")
+    }
+
+    @MainActor
+    static func shot(_ w: NSWindow, _ name: String) {
+        guard let img = CGWindowListCreateImage(.null, .optionIncludingWindow, CGWindowID(w.windowNumber),
+                                                [.boundsIgnoreFraming, .nominalResolution]) else {
+            B03Log.w("SHOT|\(name)|fehlgeschlagen")
+            return
+        }
+        let rep = NSBitmapImageRep(cgImage: img)
+        if let data = rep.representation(using: .png, properties: [:]) {
+            try? data.write(to: B03Log.base.appendingPathComponent("\(name).png"))
+            B03Log.w("SHOT|\(name)|\(img.width)x\(img.height)")
+        }
+    }
+}
