+enum B03Log {
+    static let base = URL(fileURLWithPath: "<sonde>/evidence")
+    static let lock = NSLock()
+
+    static func w(_ s: String) {
+        let line = "B03PROBE|\(String(format: "%.2f", Date().timeIntervalSince1970.truncatingRemainder(dividingBy: 10_000)))|\(s)\n"
+        lock.withLock {
+            try? FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+            let url = base.appendingPathComponent("probe.log")
+            if let h = try? FileHandle(forWritingTo: url) {
+                h.seekToEndOfFile()
+                h.write(Data(line.utf8))
+                try? h.synchronize()
+                try? h.close()
+            } else {
+                try? Data(line.utf8).write(to: url)
+            }
+            FileHandle.standardError.write(Data(line.utf8))
+        }
+    }
+
+    static func ts(_ d: Date) -> String { String(format: "%.3f", d.timeIntervalSince1970) }
+    static func f2(_ t: TimeInterval) -> String { String(format: "%.2f", t) }
+}
