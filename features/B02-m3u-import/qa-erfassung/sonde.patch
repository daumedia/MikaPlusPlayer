+import XCTest
+import SwiftData
+@testable import MikaPlusPlayer
+
+/// B02-PROBE · Datei-Import über `PlaylistImporter.importFromFile` (so ruft ihn der `fileImporter`-Callback auf).
+final class B02FileProbeTests: XCTestCase {
+    private static let small = Data("#EXTM3U\n#EXTINF:-1 group-title=\"News\",Kanal A\nhttp://127.0.0.1:9/live/a.m3u8\n#EXTINF:-1,Kanal B\nhttp://127.0.0.1:9/live/b.ts\n".utf8)
+
+    @MainActor func testF01_EndungenUndInhalte() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f01")
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let prose = Data("Einkaufsliste\nMilch, Brot\nhttp://example.invalid/kein-extinf\n".utf8)
+        let cases: [(String, Data)] = [
+            ("qa-liste.m3u", B02FileProbeTests.small),
+            ("qa-liste.M3U8", B02FileProbeTests.small),
+            ("qa-liste.txt", B02FileProbeTests.small),
+            ("notizen.txt", prose),
+            ("daten.csv", B02FileProbeTests.small),
+            ("quelltext.swift", B02FileProbeTests.small),
+            ("ohne-endung", B02FileProbeTests.small),
+            ("bild.png", Data([0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]) + B02FileProbeTests.small)
+        ]
+        for (name, data) in cases {
+            let url = dir.appendingPathComponent(name)
+            try data.write(to: url)
+            let type = (try? url.resourceValues(forKeys: [.contentTypeKey]))?.contentType?.identifier ?? "-"
+            let r = await B02.importFile(url, context: container.mainContext)
+            B02.log("F01|\(name)|typ=\(type)|\(B02.result(r))")
+        }
+    }
+
+    @MainActor func testF02_OhneLeserecht() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f02")
+        defer {
+            try? FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: dir.appendingPathComponent("gesperrt-ordner").path)
+            try? FileManager.default.removeItem(at: dir)
+        }
+        let url = dir.appendingPathComponent("gesperrt.m3u")
+        try B02FileProbeTests.small.write(to: url)
+        try FileManager.default.setAttributes([.posixPermissions: 0o000], ofItemAtPath: url.path)
+        let r = await B02.importFile(url, context: container.mainContext)
+        B02.log("F02|datei-0000|lesbar=\(FileManager.default.isReadableFile(atPath: url.path))|\(B02.result(r))")
+        try FileManager.default.setAttributes([.posixPermissions: 0o644], ofItemAtPath: url.path)
+
+        let lockedDir = dir.appendingPathComponent("gesperrt-ordner", isDirectory: true)
+        try FileManager.default.createDirectory(at: lockedDir, withIntermediateDirectories: true)
+        let inner = lockedDir.appendingPathComponent("innen.m3u")
+        try B02FileProbeTests.small.write(to: inner)
+        try FileManager.default.setAttributes([.posixPermissions: 0o000], ofItemAtPath: lockedDir.path)
+        let r2 = await B02.importFile(inner, context: container.mainContext)
+        B02.log("F02|ordner-0000|\(B02.result(r2))")
+
+        let missing = dir.appendingPathComponent("gibt-es-nicht.m3u")
+        let r3 = await B02.importFile(missing, context: container.mainContext)
+        B02.log("F02|fehlt|\(B02.result(r3))")
+    }
+
+    @MainActor func testF03_Symlinks() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f03")
+        let other = B02.tempDir("f03-ziel")
+        defer { try? FileManager.default.removeItem(at: dir); try? FileManager.default.removeItem(at: other) }
+        let target = other.appendingPathComponent("echte-liste.txt")
+        try B02FileProbeTests.small.write(to: target)
+        let fm = FileManager.default
+        let link = dir.appendingPathComponent("verweis.m3u")
+        try fm.createSymbolicLink(at: link, withDestinationURL: target)
+        let dangling = dir.appendingPathComponent("ins-leere.m3u")
+        try fm.createSymbolicLink(atPath: dangling.path, withDestinationPath: other.appendingPathComponent("weg.m3u").path)
+        let toDir = dir.appendingPathComponent("ordner.m3u")
+        try fm.createSymbolicLink(at: toDir, withDestinationURL: other)
+        let chain = dir.appendingPathComponent("kette.m3u")
+        try fm.createSymbolicLink(at: chain, withDestinationURL: link)
+        for (label, url) in [("auf Datei", link), ("ins Leere", dangling), ("auf Ordner", toDir), ("Kette", chain)] {
+            let r = await B02.importFile(url, context: container.mainContext)
+            B02.log("F03|\(label)|\(url.lastPathComponent)|\(B02.result(r))")
+        }
+    }
+
+    @MainActor func testF04_SecurityScopeUndOrdner() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f04")
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let url = dir.appendingPathComponent("scope.m3u")
+        try B02FileProbeTests.small.write(to: url)
+        let scoped = url.startAccessingSecurityScopedResource()
+        if scoped { url.stopAccessingSecurityScopedResource() }
+        var bookmarkInfo = "-"
+        do {
+            let data = try url.bookmarkData(options: .withSecurityScope, includingResourceValuesForKeys: nil, relativeTo: nil)
+            var stale = false
+            let resolved = try URL(resolvingBookmarkData: data, options: .withSecurityScope, relativeTo: nil, bookmarkDataIsStale: &stale)
+            let s2 = resolved.startAccessingSecurityScopedResource()
+            if s2 { resolved.stopAccessingSecurityScopedResource() }
+            bookmarkInfo = "bookmarkMitScope=ok|startAccessingAufBookmarkURL=\(s2)"
+        } catch {
+            bookmarkInfo = "bookmarkMitScope=fehler(\((error as NSError).code))"
+        }
+        let r = await B02.importFile(url, context: container.mainContext)
+        B02.log("F04|startAccessingAufNormalerURL=\(scoped)|\(bookmarkInfo)|\(B02.result(r))")
+        let r2 = await B02.importFile(dir, context: container.mainContext)
+        B02.log("F04|ordner-statt-datei|\(B02.result(r2))")
+        B02.log("F04|sandboxEntitlement=\(Bundle.main.object(forInfoDictionaryKey: "com.apple.security.app-sandbox") as Any)|umgebung=APP_SANDBOX_CONTAINER_ID:\(ProcessInfo.processInfo.environment["APP_SANDBOX_CONTAINER_ID"] ?? "nil")")
+    }
+
+    /// Named Pipe: zeigt, dass die Datei synchron auf dem Main-Thread gelesen wird (Stellvertreter für langsame Volumes).
+    @MainActor func testF05_LangsameDateiBlockiertMainThread() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f05")
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let fifo = dir.appendingPathComponent("langsam.m3u")
+        XCTAssertEqual(mkfifo(fifo.path, 0o644), 0)
+        let payload = B02FileProbeTests.small
+        let path = fifo.path
+        Thread.detachNewThread {
+            Thread.sleep(forTimeInterval: 3)
+            let end = Date().addingTimeInterval(10)
+            var fd: Int32 = -1
+            while fd < 0 && Date() < end {
+                fd = open(path, O_WRONLY | O_NONBLOCK)
+                if fd < 0 { Thread.sleep(forTimeInterval: 0.05) }
+            }
+            guard fd >= 0 else { return }
+            _ = fcntl(fd, F_SETFL, 0)
+            payload.withUnsafeBytes { _ = write(fd, $0.baseAddress, $0.count) }
+            close(fd)
+        }
+        let watchdog = MainThreadWatchdog()
+        watchdog.start()
+        try await Task.sleep(nanoseconds: 200_000_000)
+        let start = Date()
+        let r = await B02.importFile(fifo, context: container.mainContext)
+        let elapsed = Date().timeIntervalSince(start)
+        try await Task.sleep(nanoseconds: 300_000_000)
+        let gap = watchdog.stop()
+        B02.log("F05|fifo-Schreiber-nach-3s|gesamt=\(B02.fmt(elapsed))s|maxMainThreadBlockade=\(B02.fmt(gap))s|\(B02.result(r))")
+    }
+
+    func testF06_iCloudOrdner() {
+        let home = FileManager.default.homeDirectoryForCurrentUser
+        let icloud = home.appendingPathComponent("Library/Mobile Documents/com~apple~CloudDocs", isDirectory: true)
+        var isDir: ObjCBool = false
+        let exists = FileManager.default.fileExists(atPath: icloud.path, isDirectory: &isDir)
+        B02.log("F06|iCloudDriveOrdnerVorhanden=\(exists && isDir.boolValue)|nicht ausgefuehrt: keine Datei in iCloud Drive erzeugt, keine vorhandene gelesen (koennte Zugangsdaten enthalten)")
+    }
+
+    @MainActor func testF07_Dateinamen() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f07")
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let cases: [(String, String)] = [
+            ("liste.v2.m3u", ""),
+            (".m3u", ""),
+            (".versteckt.m3u", ""),
+            ("Sender & Ümlaut (Kopie).M3U8", ""),
+            ("liste.m3u", "   "),
+            ("liste.m3u", "Eigener Name"),
+            (String(repeating: "n", count: 250) + ".m3u", "")
+        ]
+        for (file, name) in cases {
+            let url = dir.appendingPathComponent(file)
+            try B02FileProbeTests.small.write(to: url)
+            let r = await B02.importFile(url, name: name, context: container.mainContext)
+            let shown = (try? r.get()).map { "name=\($0.name.count > 60 ? "<\($0.name.count) Zeichen>" : $0.name.debugDescription)|sourceURL=\($0.sourceURL?.absoluteString ?? "nil")|isRemote=\($0.isRemote)|lastRefreshed=\($0.lastRefreshed == nil ? "nil" : "gesetzt")" } ?? B02.result(r)
+            B02.log("F07|datei=\(file.count > 60 ? "<\(file.count) Zeichen>" : file.debugDescription)|eingabeName=\(name.debugDescription)|\(shown)")
+        }
+    }
+
+    @MainActor func testF08_RelativeAdressenInDatei() async throws {
+        let container = try B01.inMemoryContainer()
+        let dir = B02.tempDir("f08")
+        defer { try? FileManager.default.removeItem(at: dir) }
+        try Data("x".utf8).write(to: dir.appendingPathComponent("stream.ts"))
+        let text = "#EXTM3U\n#EXTINF:-1,Relativ\nstream.ts\n#EXTINF:-1,Absolut\nfile://\(dir.appendingPathComponent("stream.ts").path)\n"
+        let url = dir.appendingPathComponent("relativ.m3u")
+        try Data(text.utf8).write(to: url)
+        let r = await B02.importFile(url, context: container.mainContext)
+        B02.log("F08|\(B02.result(r).replacingOccurrences(of: dir.path, with: "<tmp>"))")
+    }
+
+    /// 50-MB-Datei (1.000 Einträge mit ~52-KB-Namen), Temp-Store-Datei.
+    @MainActor func testF09_50MBDatei() async throws {
+        let dir = B02.tempDir("f09")
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let (container, storeURL, storeDir) = try B01.tempFileContainer("b02f09")
+        defer { try? FileManager.default.removeItem(at: storeDir) }
+        let url = dir.appendingPathComponent("gross.m3u")
+        let data = B02.m3u(1_000, nameLength: 52_000)
+        try data.write(to: url)
+        let before = B02.footprintMB()
+        let watchdog = MainThreadWatchdog()
+        watchdog.start()
+        let start = Date()
+        let r = await B02.importFile(url, context: container.mainContext)
+        let elapsed = Date().timeIntervalSince(start)
+        try await Task.sleep(nanoseconds: 300_000_000)
+        let gap = watchdog.stop()
+        let after = B02.footprintMB()
+        var storeBytes = 0
+        for s in ["", "-wal", "-shm"] {
+            storeBytes += ((try? FileManager.default.attributesOfItem(atPath: storeURL.path + s))?[.size] as? Int) ?? 0
+        }
+        let p = try? r.get()
+        B02.log("F09|dateiBytes=\(data.count)|ergebnis=\(B02.message(r) ?? "OK")|sender=\(p?.channelCount ?? -1)|laengsterName=\(p?.channels.map(\.name.count).max() ?? -1)|gesamt=\(B02.fmt(elapsed))s|maxMainThreadBlockade=\(B02.fmt(gap))s|speicherVorher=\(Int(before))MB|nachher=\(Int(after))MB|storeBytes=\(storeBytes)")
+    }
+}
