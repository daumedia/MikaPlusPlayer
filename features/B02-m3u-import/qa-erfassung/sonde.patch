@@ -0,0 +1,37 @@
+import XCTest
+import SwiftData
+@testable import MikaPlusPlayer
+
+/// B02-PROBE · Was geht beim URL-Abruf an den Server (Kopfzeilen), und speichert die App Cookies des Servers?
+final class B02KopfzeilenProbeTests: B01MockTestCase {
+
+    @MainActor func testU09_KopfzeilenUndCookies() async throws {
+        let marker = "qa-cookie-b02u09-\(UInt32.random(in: 1000...9999))"
+        let body = Data("#EXTM3U\n#EXTINF:-1,Kopf\nhttp://127.0.0.1:9/live/1.ts\n".utf8)
+        mock.handler = { req in
+            .custom(status: 200, headers: ["Content-Type": "audio/x-mpegurl",
+                                           "Set-Cookie": "sitzung=\(marker); Max-Age=3600; Path=/"], body: body)
+        }
+        let container = try B01.inMemoryContainer()
+        _ = try await B02.importURL("http://\(mock.hostPort)/liste.m3u?password=qa-pass-u09", context: container.mainContext).get()
+        _ = try await B02.importURL("http://\(mock.hostPort)/liste.m3u?password=qa-pass-u09", context: container.mainContext).get()
+        for (i, r) in mock.requests.enumerated() {
+            let h = r.headers
+            B02.log("U09|anfrage\(i + 1)|kopfzeilen=\(h.keys.sorted())|user-agent=\(h["user-agent"] ?? "-")|accept=\(h["accept"] ?? "-")|accept-language=\(h["accept-language"] ?? "-")|cookieGesendet=\(h["cookie"]?.contains(marker) ?? false)|referer=\(h["referer"] ?? "-")")
+        }
+        let url = URL(string: "http://\(mock.hostPort)/")!
+        let stored = HTTPCookieStorage.shared.cookies(for: url)?.filter { $0.value == marker } ?? []
+        B02.log("U09|cookieImSpeicher=\(stored.count)|ablauf=\(stored.first?.expiresDate.map { _ in "gesetzt" } ?? "-")")
+        try await Task.sleep(nanoseconds: 1_500_000_000)
+        let storages = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Library/HTTPStorages/\(Bundle.main.bundleIdentifier ?? "-")")
+        var onDisk = 0
+        if let e = FileManager.default.enumerator(at: storages, includingPropertiesForKeys: nil) {
+            for case let f as URL in e {
+                if let d = try? Data(contentsOf: f), d.range(of: Data(marker.utf8)) != nil { onDisk += 1 }
+            }
+        }
+        B02.log("U09|cookieAufPlatte=<HTTPStorages>/\(Bundle.main.bundleIdentifier ?? "-")|dateienMitCookie=\(onDisk)")
+        for c in stored { HTTPCookieStorage.shared.deleteCookie(c) }
+        for req in mock.requests { if let u = URL(string: "http://\(mock.hostPort)\(req.target)") { URLCache.shared.removeCachedResponse(for: URLRequest(url: u)) } }
+    }
+}
diff -ruN -x build -x MikaPlusPlayer.xcodeproj -x .DS_Store snapshot-b01/Tests/B02/B02LangsamProbeTests.swift b02probe/Tests/B02/B02LangsamProbeTests.swift
--- snapshot-b01/Tests/B02/B02LangsamProbeTests.swift	1970-01-01 01:00:00
+++ b02probe/Tests/B02/B02LangsamProbeTests.swift	2026-09-16 14:45:22
@@ -0,0 +1,68 @@
+import XCTest
+import SwiftData
+@testable import MikaPlusPlayer
+
+/// B02-PROBE · langsame Fälle: Leerlauf, Tröpfeln ohne Gesamtfrist, 17.000 Sender.
+final class B02LangsamProbeTests: B01MockTestCase {
+
+    @MainActor func testL01_Leerlauf() async throws {
+        mock.handler = { _ in .hang }
+        let container = try B01.inMemoryContainer()
+        let start = Date()
+        let r = await B02.importURL("http://\(mock.hostPort)/haengt.m3u?password=qa-pass-l01", context: container.mainContext)
+        B02.log("L01|haengt|dauer=\(B02.fmt(Date().timeIntervalSince(start)))s|\(B02.result(r))")
+    }
+
+    /// Antwort tröpfelt in 10 Stücken alle 10 s (≈ 100 s gesamt) – länger als die 60-s-Leerlaufgrenze.
+    @MainActor func testL02_TroepfelnOhneGesamtfrist() async throws {
+        let body = B02.m3u(20)
+        mock.handler = { _ in .trickle(body: body, chunks: 10, interval: 10) }
+        let container = try B01.inMemoryContainer()
+        let start = Date()
+        let r = await B02.importURL("http://\(mock.hostPort)/troepfelt.m3u", context: container.mainContext)
+        B02.log("L02|troepfelt-10x10s|bytes=\(body.count)|dauer=\(B02.fmt(Date().timeIntervalSince(start)))s|ergebnis=\(B02.message(r) ?? "OK")|sender=\((try? r.get())?.channelCount ?? -1)")
+    }
+
+    /// Import per URL, In-Memory-Container wie die B01-Messung (EC-20). Größen per B02_SIZES.
+    @MainActor func testL03_GrosseListePerURL() async throws {
+        let sizes = (ProcessInfo.processInfo.environment["B02_SIZES"] ?? "").split(separator: ",").compactMap { Int($0) }
+        for n in (sizes.isEmpty ? [1_500, 3_000, 6_000, 17_000] : sizes) {
+            try await measure(n: n, fileStore: false)
+        }
+    }
+
+    /// Wie L03, aber mit Store-Datei. Größen per B02_FILESTORE_SIZES.
+    @MainActor func testL04_GrosseListePerURLMitStoreDatei() async throws {
+        let sizes = (ProcessInfo.processInfo.environment["B02_FILESTORE_SIZES"] ?? "").split(separator: ",").compactMap { Int($0) }
+        for n in (sizes.isEmpty ? [6_000] : sizes) {
+            try await measure(n: n, fileStore: true)
+        }
+    }
+
+    @MainActor private func measure(n: Int, fileStore: Bool) async throws {
+        let body = B02.m3u(n)
+        mock.handler = { _ in .raw(status: 200, contentType: "audio/x-mpegurl", body: body) }
+        let container: ModelContainer
+        var cleanup: URL?
+        if fileStore {
+            let (c, _, d) = try B01.tempFileContainer("b02l04-\(n)")
+            container = c; cleanup = d
+        } else {
+            container = try B01.inMemoryContainer()
+        }
+        defer { if let cleanup { try? FileManager.default.removeItem(at: cleanup) } }
+        let watchdog = MainThreadWatchdog()
+        watchdog.start()
+        try await Task.sleep(nanoseconds: 200_000_000)
+        let start = Date()
+        let r = await B02.importURL("http://\(mock.hostPort)/liste-\(n).m3u", context: container.mainContext)
+        let elapsed = Date().timeIntervalSince(start)
+        try await Task.sleep(nanoseconds: 300_000_000)
+        let gap = watchdog.stop()
+        let p = try r.get()
+        let pid = p.id
+        let stored = try container.mainContext.fetchCount(FetchDescriptor<Channel>(predicate: #Predicate { $0.playlistID == pid }))
+        B02.log("L0\(fileStore ? 4 : 3)|\(fileStore ? "storeDatei" : "inMemory")|sender=\(p.channelCount)|bytes=\(body.count)|gesamt=\(B02.fmt(elapsed))s|maxMainThreadBlockade=\(B02.fmt(gap))s|playlistID=\(stored)|beziehung=\(p.channels.count)")
+        mock.resetLog()
+    }
+}
