+import XCTest
+import SwiftUI
+import SwiftData
+import AppKit
+@testable import MikaPlusPlayer
+
+/// B02-PROBE · Reiter „URL" und „Datei" des Import-Sheets, bedient in einem echten Fenster des Test-Hosts
