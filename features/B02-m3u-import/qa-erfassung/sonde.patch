diff -ruN -x build -x MikaPlusPlayer.xcodeproj -x .DS_Store snapshot-b01/Tests/B02/B02ProbeSupport.swift b02probe/Tests/B02/B02ProbeSupport.swift
--- snapshot-b01/Tests/B02/B02ProbeSupport.swift	1970-01-01 01:00:00
+++ b02probe/Tests/B02/B02ProbeSupport.swift	2026-09-16 14:41:33
@@ -0,0 +1,83 @@
+import Foundation
+import SwiftData
+import XCTest
+@testable import MikaPlusPlayer
+
+/// B02-PROBE: TEMPORÄRE Verhaltenssonde für die Rückerfassung von B02 (M3U-Import).
+/// Läuft nur in der Scratchpad-Kopie, wird nicht eingecheckt. Erfundene Daten, nur Loopback-Mocks.
+enum B02 {
+    static let runDir = URL(fileURLWithPath: "<scratchpad>/b02run")
+
+    static func log(_ s: String) { print("B02PROBE|" + s) }
+
+    static func tempDir(_ label: String) -> URL {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent("b02-probe-\(label)-\(UUID().uuidString)", isDirectory: true)
+        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        return dir
+    }
+
+    /// physischer Speicher des Prozesses (phys_footprint) in MB
+    static func footprintMB() -> Double {
+        var info = task_vm_info_data_t()
+        var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+        let kr = withUnsafeMutablePointer(to: &info) {
+            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+                task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+            }
+        }
+        return kr == KERN_SUCCESS ? Double(info.phys_footprint) / 1_048_576 : -1
+    }
+
+    static func fmt(_ t: TimeInterval) -> String { String(format: "%.2f", t) }
+
+    /// Kurzdarstellung geparster Sender
+    static func show(_ r: [ParsedChannel]) -> String {
+        r.map { c in
+            let nonASCII = c.name.unicodeScalars.filter { !$0.isASCII }.map { String(format: "U+%04X", $0.value) }
+            return "{name=\(c.name.debugDescription)\(nonASCII.isEmpty ? "" : " skalare=\(nonASCII)") url=\(c.streamURL.absoluteString) gruppe=\(c.group?.debugDescription ?? "nil") tvg=\(c.tvgID?.debugDescription ?? "nil") logo=\(c.logoURL?.absoluteString ?? "nil")}"
+        }.joined(separator: " ")
+    }
+
+    static func show(_ p: Playlist) -> String {
+        let chans = p.channels.sorted { $0.name < $1.name }.map { c -> String in
+            let nonASCII = c.name.unicodeScalars.filter { !$0.isASCII }.map { String(format: "U+%04X", $0.value) }
+            return "{name=\(c.name.debugDescription)\(nonASCII.isEmpty ? "" : " skalare=\(nonASCII)") gruppe=\(c.group?.debugDescription ?? "nil") url=\(c.streamURL.absoluteString)}"
+        }
+        return "playlist name=\(p.name.debugDescription) sourceURL=\(p.sourceURL?.absoluteString ?? "nil") isRemote=\(p.isRemote) isXtream=\(p.isXtream) channelCount=\(p.channelCount) lastRefreshed=\(p.lastRefreshed == nil ? "nil" : "gesetzt") sender=\(chans.joined(separator: " "))"
+    }
+
+    /// Import über den echten Pfad der App (`PlaylistImporter.importFromURL`), wie `ImportPlaylistView.importFromURL`.
+    @MainActor
+    static func importURL(_ s: String, name: String = "", context: ModelContext) async -> Result<Playlist, Error> {
+        do { return .success(try await PlaylistImporter(modelContext: context).importFromURL(s, name: name)) }
+        catch { return .failure(error) }
+    }
+
+    /// Import über den echten Pfad der App (`PlaylistImporter.importFromFile`), wie `ImportPlaylistView.importFromFile`
+    /// (die Ansicht reicht `name.isEmpty ? nil : name` weiter).
+    @MainActor
+    static func importFile(_ url: URL, name: String = "", context: ModelContext) async -> Result<Playlist, Error> {
+        do { return .success(try await PlaylistImporter(modelContext: context).importFromFile(url, name: name.isEmpty ? nil : name)) }
+        catch { return .failure(error) }
+    }
+
+    static func result(_ r: Result<Playlist, Error>) -> String {
+        switch r {
+        case .success(let p): return "OK " + show(p)
+        case .failure(let e): return "FEHLER \(e.localizedDescription.debugDescription)"
+        }
+    }
+
+    /// Realistische M3U mit `n` Einträgen.
+    static func m3u(_ n: Int, streamHost: String = "127.0.0.1:9", nameLength: Int = 0) -> Data {
+        var s = "#EXTM3U\n"
+        s.reserveCapacity(n * (160 + nameLength))
+        let pad = nameLength > 0 ? " " + String(repeating: "x", count: nameLength) : ""
+        for i in 0..<n {
+            s += "#EXTINF:-1 tvg-id=\"sender.\(i)\" tvg-logo=\"http://logos.example/\(i).png\" group-title=\"Gruppe \(i % 300)\",DE: Sender \(i) HD\(pad)\n"
+            s += "http://\(streamHost)/live/\(i).ts\n"
+        }
+        return Data(s.utf8)
+    }
+}
