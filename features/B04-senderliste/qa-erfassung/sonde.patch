+    func findScrollViews(_ v: NSView) -> [NSScrollView] {
+        var out: [NSScrollView] = []
+        if let s = v as? NSScrollView { out.append(s) }
+        for sub in v.subviews { out += findScrollViews(sub) }
+        return out
+    }
+
+    func verticalScrollView(_ hv: NSView) -> NSScrollView? {
+        findScrollViews(hv)
+            .filter { ($0.documentView?.bounds.height ?? 0) > $0.contentSize.height + 10 }
+            .max { ($0.documentView?.bounds.height ?? 0) < ($1.documentView?.bounds.height ?? 0) }
+    }
+
+    func searchField(_ w: NSWindow) -> NSSearchField? {
+        if let items = w.toolbar?.items {
+            for it in items {
+                if let sf = (it as? NSSearchToolbarItem)?.searchField { return sf }
+                if let sf = it.view as? NSSearchField { return sf }
+                if let found = it.view.flatMap({ firstSearchField($0) }) { return found }
+            }
+        }
+        if let root = w.contentView?.superview ?? w.contentView { return firstSearchField(root) }
+        return nil
+    }
+
+    func firstSearchField(_ v: NSView) -> NSSearchField? {
+        if let s = v as? NSSearchField { return s }
+        for sub in v.subviews { if let f = firstSearchField(sub) { return f } }
+        return nil
+    }
+
+    func type(_ text: String, into sf: NSSearchField) {
+        sf.stringValue = text
+        if let editor = sf.currentEditor() { editor.string = text }
+        sf.delegate?.controlTextDidChange?(Notification(name: NSControl.textDidChangeNotification, object: sf))
+        NotificationCenter.default.post(name: NSControl.textDidChangeNotification, object: sf)
+    }
