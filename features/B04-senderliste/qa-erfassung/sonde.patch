+    /// Stoesst das Realisieren der LazyVStack-Zeilen an (im Test-Fenster ohne Nutzerinteraktion noetig).
+    func nudge(_ hv: NSView) {
+        let all = findScrollViews(hv)
+        p("nudge|scrollViews=\(all.map { "\(Int($0.documentView?.bounds.height ?? -1))/\(Int($0.contentSize.height))" })")
+        guard let sv = verticalScrollView(hv) else { p("nudge|kein vertikaler ScrollView"); return }
+        let doc = sv.documentView?.bounds.height ?? 0
+        var y: CGFloat = 0
+        while y < doc {
+            sv.contentView.scroll(to: NSPoint(x: 0, y: y))
+            sv.reflectScrolledClipView(sv.contentView)
+            RunLoop.main.run(until: Date().addingTimeInterval(0.4))
+            y += max(36, sv.contentSize.height * 0.8)
+        }
+        sv.contentView.scroll(to: .zero)
+        sv.reflectScrolledClipView(sv.contentView)
+        p("nudge|durchgescrollt|doc=\(Int(doc))|t=\(now())")
+    }
+
+    func now() -> String { String(format: "%.1f", Date().timeIntervalSince1970) }
