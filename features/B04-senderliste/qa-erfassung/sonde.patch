+#!/usr/bin/env python3
+"""B04-Sonde: lokaler Logo-Host. Protokolliert jede Anfrage (JSON-Zeilen) inkl. Kopfzeilen
+und ob der Client die Verbindung vor der Antwort geschlossen hat. Nur 127.0.0.1."""
+import json, os, socket, struct, sys, threading, time, zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import urlparse, parse_qs
+
+LOG = sys.argv[1]
+PORTS = [int(p) for p in sys.argv[2:]] or [18790, 18791]
+lock = threading.Lock()
+
+
+def log(ev):
+    ev["t"] = round(time.time(), 3)
+    with lock:
+        with open(LOG, "a") as f:
+            f.write(json.dumps(ev) + "\n")
+
+
+def png(w, h, rgb=(40, 120, 200), noise=False):
+    if noise:
+        raw = bytearray()
+        for _ in range(h):
+            raw += b"\x00" + os.urandom(w * 3)
+        comp = zlib.compress(bytes(raw), 1)
+    else:
+        row = b"\x00" + bytes(rgb) * w
+        c = zlib.compressobj(9)
+        parts = [c.compress(row) for _ in range(h)]
+        parts.append(c.flush())
+        comp = b"".join(parts)
+
+    def chunk(t, d):
+        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
+
+    return (b"\x89PNG\r\n\x1a\n"
+            + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
+            + chunk(b"IDAT", comp) + chunk(b"IEND", b""))
+
+
+SMALL = png(64, 64, (220, 60, 60))
+BIG_DIM = png(12000, 12000, (60, 160, 60))   # kleine Datei, ~576 MB dekodiert
+BIG_FILE = png(3000, 3000, noise=True)       # ~27 MB Uebertragung
+
+
+class H(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, *a):
+        pass
+
+    def client_closed(self):
+        try:
+            self.connection.setblocking(False)
+            d = self.connection.recv(1, socket.MSG_PEEK)
+            self.connection.setblocking(True)
+            return d == b""
+        except BlockingIOError:
+            self.connection.setblocking(True)
+            return False
+        except OSError:
+            return True
+
+    def wait(self, seconds):
+        end = time.time() + seconds
+        while time.time() < end:
+            if self.client_closed():
+                return False
+            time.sleep(0.05)
+        return True
+
+    def send(self, code, body, ctype="image/png", extra=None):
+        self.send_response(code)
+        self.send_header("Content-Type", ctype)
+        self.send_header("Content-Length", str(len(body)))
+        for k, v in (extra or {}).items():
+            self.send_header(k, v)
+        self.end_headers()
+        try:
+            self.wfile.write(body)
+            return True
+        except OSError:
+            return False
+
+    def do_GET(self):
+        u = urlparse(self.path)
+        q = parse_qs(u.query)
+        ev = {"port": self.server.server_address[1], "path": self.path,
+              "headers": dict(self.headers.items())}
+        p = u.path
+        result = "ok"
+        if p.startswith("/logo/"):
+            ok = self.send(200, SMALL, extra={"Cache-Control": "public, max-age=86400"})
+        elif p.startswith("/nocache/"):
+            ok = self.send(200, SMALL)
+        elif p.startswith("/nostore/"):
+            ok = self.send(200, SMALL, extra={"Cache-Control": "no-store"})
+        elif p.startswith("/html"):
+            ok = self.send(200, b"<html><body>kein Bild</body></html>", "text/html; charset=utf-8")
+        elif p.startswith("/pngtype-html"):
+            ok = self.send(200, b"<html><body>kein Bild</body></html>", "image/png")
+        elif p.startswith("/json"):
+            ok = self.send(200, b'{"x":1}', "application/json")
+        elif p.startswith("/404"):
+            ok = self.send(404, b"not found", "text/plain")
+        elif p.startswith("/redirect-loop"):
+            ok = self.send(302, b"", "text/plain", {"Location": self.path})
+        elif p.startswith("/redirect"):
+            target = q.get("to", ["http://localhost:18791/logo/redirected.png"])[0]
+            ok = self.send(302, b"", "text/plain", {"Location": target})
+        elif p.startswith("/bigdim"):
+            ok = self.send(200, BIG_DIM, extra={"Cache-Control": "public, max-age=86400"})
+        elif p.startswith("/bigfile"):
+            ok = self.send(200, BIG_FILE, extra={"Cache-Control": "public, max-age=86400"})
+        elif p.startswith("/m3ufile/"):
+            fn = os.path.join(os.path.dirname(os.path.abspath(__file__)), "m3u", os.path.basename(p))
+            body = open(fn, "rb").read() if os.path.exists(fn) else b""
+            ok = self.send(200 if body else 404, body, "audio/x-mpegurl")
+        elif p.startswith("/slow/"):
+            delay = float(q.get("d", ["5"])[0])
+            log(dict(ev, event="slow-start"))
+            if not self.wait(delay):
+                log(dict(ev, event="closed-before-response", after=delay))
+                return
+            ok = self.send(200, SMALL)
+            result = "slow-done"
+        elif p.startswith("/trickle"):
+            total = int(q.get("s", ["300"])[0])
+            log(dict(ev, event="trickle-start"))
+            self.send_response(200)
+            self.send_header("Content-Type", "image/png")
+            self.send_header("Content-Length", str(len(SMALL)))
+            self.end_headers()
+            sent, start, ok = 0, time.time(), True
+            while time.time() - start < total and sent < len(SMALL):
+                try:
+                    self.wfile.write(SMALL[sent:sent + 1])
+                    self.wfile.flush()
+                except OSError:
+                    ok = False
+                    break
+                sent += 1
+                if not self.wait(10):
+                    ok = False
+                    break
+            log(dict(ev, event="trickle-end", sent=sent,
+                     seconds=round(time.time() - start, 1), ok=ok))
+            return
+        else:
+            ok = self.send(404, b"unknown", "text/plain")
+        log(dict(ev, event=result, delivered=ok))
+
+
+for port in PORTS:
+    s = ThreadingHTTPServer(("127.0.0.1", port), H)
+    s.daemon_threads = True
+    threading.Thread(target=s.serve_forever, daemon=True).start()
+print("listening", PORTS, "bigdim", len(BIG_DIM), "bigfile", len(BIG_FILE), flush=True)
+while True:
+    time.sleep(3600)
