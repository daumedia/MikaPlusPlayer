+    func axLines(_ root: Any, maxDepth: Int = 60) -> [String] {
+        var out: [String] = []
+        func walk(_ el: Any, _ d: Int) {
+            guard d < maxDepth else { return }
+            let o = el as AnyObject
+            let role = (o.accessibilityRole?() as NSAccessibility.Role??)??.rawValue ?? "?"
+            var parts: [String] = []
+            if let l = (o.accessibilityLabel?() as String??) ?? nil, !l.isEmpty { parts.append("L:\(l)") }
+            if let t = (o.accessibilityTitle?() as String??) ?? nil, !t.isEmpty { parts.append("T:\(t)") }
+            if let v = (o.accessibilityValue?() as Any??) ?? nil {
+                let s = "\(v)"
+                if !s.isEmpty && s != "<null>" { parts.append("V:\(s)") }
+            }
+            out.append("\(String(repeating: " ", count: d))\(role) \(parts.joined(separator: " "))")
+            let children = ((o.accessibilityChildren?() as [Any]??) ?? nil) ?? []
+            for c in children { walk(c, d + 1) }
+        }
+        walk(root, 0)
+        return out
+    }
+
+    func axElements(_ root: Any, maxDepth: Int = 60) -> [(role: String, text: String, el: AnyObject)] {
+        var out: [(String, String, AnyObject)] = []
+        func walk(_ el: Any, _ d: Int) {
+            guard d < maxDepth else { return }
+            let o = el as AnyObject
+            let role = (o.accessibilityRole?() as NSAccessibility.Role??)??.rawValue ?? "?"
+            var text = ""
+            if let l = (o.accessibilityLabel?() as String??) ?? nil, !l.isEmpty { text = l }
+            if text.isEmpty, let t = (o.accessibilityTitle?() as String??) ?? nil, !t.isEmpty { text = t }
+            if text.isEmpty, let v = (o.accessibilityValue?() as Any??) ?? nil {
+                let sv = "\(v)"
+                if sv != "<null>" { text = sv }
+            }
+            if text.isEmpty, let d = (o.accessibilityValueDescription?() as String??) ?? nil { text = d }
+            out.append((role, text, o))
+            let children = ((o.accessibilityChildren?() as [Any]??) ?? nil) ?? []
+            for c in children { walk(c, d + 1) }
+        }
+        walk(root, 0)
+        return out
+    }
+
+    func press(_ label: String, in root: Any) -> Bool {
+        for e in axElements(root) where e.text == label && e.role == "AXButton" {
+            _ = e.el.accessibilityPerformPress?()
+            return true
+        }
+        return false
+    }
