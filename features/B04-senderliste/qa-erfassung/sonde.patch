+    func logoScenario(_ store: String, _ items: [(String, String?, String?)], height: CGFloat, stages: [Double], leaveAfter: Double?) throws {
+        let c = try makeContainer(store, fresh: true)
+        let ctx = c.mainContext
+        let pl = seed(ctx, name: store, items: items)
+        let model = NavModel()
+        let (w, hv) = host(ProbeRoot(model: model), c, width: 900, height: height)
+        spin(0.5)
+        p("\(store)|MARK|push|t=\(now())|speicherMB=\(String(format: "%.0f", footprintMB()))")
+        model.path = [pl]
+        spin(0.8)
+        nudge(hv)
+        var elapsed = 0.8
+        for st in stages {
+            spin(st - elapsed)
+            elapsed = st
+            p("\(store)|nach\(Int(st))s|t=\(now())|spinner=\(spinnerRows(hv, w))|speicherMB=\(String(format: "%.0f", footprintMB()))")
+        }
+        if let leave = leaveAfter {
+            model.path = []
+            p("\(store)|MARK|liste-verlassen|t=\(now())")
+            spin(leave)
+            p("\(store)|MARK|nach-verlassen|t=\(now())|speicherMB=\(String(format: "%.0f", footprintMB()))")
+        }
+        w.orderOut(nil)
+    }
