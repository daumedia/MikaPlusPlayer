+    func rollen(_ hv: NSView) -> String {
+        var hist: [String: Int] = [:]
+        for e in axElements(hv) { hist[e.role, default: 0] += 1 }
+        return hist.sorted { $0.key < $1.key }.map { "\($0.key)=\($0.value)" }.joined(separator: " ")
+    }
+
+    func schritt(_ name: String, _ w: NSWindow, _ hv: NSView) {
+        p("schritt|\(name)|" + rollen(hv) + "|texte=" + axElements(hv).filter { $0.role == "AXStaticText" }.map(\.text).joined(separator: " / ") + "|chips=" + axElements(hv).filter { $0.role == "AXButton" && !$0.text.isEmpty }.map(\.text).joined(separator: " / "))
+        snapshot(w, name: name)
+        windowImage(w, name: "w-" + name)
+    }
+
+
+    func viewHistogram(_ v: NSView) -> String {
+        var hist: [String: Int] = [:]
+        func walk(_ x: NSView) {
+            hist[String(describing: Swift.type(of: x)), default: 0] += 1
+            for sub in x.subviews { walk(sub) }
+        }
+        walk(v)
+        return hist.sorted { $0.key < $1.key }.map { "\($0.key)=\($0.value)" }.joined(separator: " ")
+    }
+
+    func progressIndicators(_ v: NSView) -> [NSView] {
+        var out: [NSView] = []
+        func walk(_ x: NSView) {
+            if String(describing: Swift.type(of: x)).contains("Progress") || x is NSProgressIndicator { out.append(x) }
+            for sub in x.subviews { walk(sub) }
+        }
+        walk(v)
+        return out
+    }
+
+    func windowImage(_ w: NSWindow, name: String) {
+        guard let img = CGWindowListCreateImage(.null, .optionIncludingWindow, CGWindowID(w.windowNumber), [.boundsIgnoreFraming, .nominalResolution]) else {
+            p("windowImage|\(name)|nil")
+            return
+        }
+        let rep = NSBitmapImageRep(cgImage: img)
+        if let data = rep.representation(using: .png, properties: [:]) {
+            try? data.write(to: Self.base.appendingPathComponent("evidence/\(name).png"))
+            p("windowImage|\(name)|\(img.width)x\(img.height)|bytes=\(data.count)")
+        }
+    }
+
+    func rowState(_ hv: NSView) -> [String] {
+        ["ladeindikatoren=\(progressIndicators(hv).count)", "views: " + viewHistogram(hv)]
+    }
+
+    func spinnerRows(_ hv: NSView, _ w: NSWindow) -> String {
+        progressIndicators(hv).filter { $0 is NSProgressIndicator }.map { v -> String in
+            let r = v.convert(v.bounds, to: nil)
+            return "y=\(Int(w.contentLayoutRect.height - r.midY))"
+        }.joined(separator: ",")
+    }
+
