<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DMG-Distribution (kein App Store): Sandbox deaktiviert, damit der
	     Sparkle-Updater wie bei den anderen Mika+ Apps funktioniert. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- B09 · BF-09 (2026-10-02): disable-library-validation entfernt. Das Release ist mit Developer ID
	     signiert; Xcode signiert VLCKit und Sparkle beim Einbetten mit derselben Team-ID, die Library
	     Validation der Hardened Runtime lässt sie damit zu. Debug läuft ohne Hardened Runtime. -->
</dict>
</plist>
